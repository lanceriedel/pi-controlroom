elif cmd=="event":   # (008) controlroom event <kind> [arg] — see event() above
    if not args: die("usage: controlroom event <flush-requested <pct> | compaction <tokensBefore> | ext-error <msg> | …> [arg]")
    event(args[0],args[1] if len(args)>1 else "",args[2] if len(args)>2 else "ext")   # (012) 3rd arg = source (ext | manual | tick)
else: print(f"cr5: unknown {cmd}",file=sys.stderr); sys.exit(1)
PY
}
tick_label(){ echo "io.controlroom.tick.$(python3 -c 'import hashlib,sys;print(hashlib.sha1(sys.argv[1].encode()).hexdigest()[:8])' "$ROOT")"; }
tick_install(){   # idempotent: write plist, bootstrap if not loaded. Linux / no launchd → --loop fallback hint
  cr5 auto init
  [ -s "$ROOT/logs/.controller" ] || { p=$(herdr agent list 2>/dev/null | WS="$WS" python3 -c 'import json,sys,os
ws=os.environ.get("WS"); print(next((a["pane_id"] for a in json.load(sys.stdin)["result"]["agents"] if a.get("name")=="controller" and (not ws or a.get("workspace_id")==ws)),""))' 2>/dev/null); [ -n "$p" ] && echo "$p" > "$ROOT/logs/.controller" && echo "controller pane → $p (logs/.controller)"; }   # (006) L012: pin the controller by pane id, once, by name
  if [ "$(uname)" != Darwin ]; then echo "tick      no launchd here — run: controlroom tick --loop (statusbar starts it on non-macOS)"; return 0; fi
  lab=$(tick_label); mkdir -p "$HOME/.config/controlroom/launchd"; PL="$HOME/.config/controlroom/launchd/$lab.plist"
  cr5 plist "$lab" > "$PL"
  if perl -e 'alarm 10; exec @ARGV' -- launchctl print "gui/$(id -u)/$lab" >/dev/null 2>&1; then echo "tick      launchd $lab already loaded (60 s) · $PL"
  else perl -e 'alarm 15; exec @ARGV' -- launchctl bootstrap "gui/$(id -u)" "$PL" 2>&1 && echo "tick      launchd $lab bootstrapped (60 s) · $PL"; fi
}
tick_uninstall(){
  lab=$(tick_label); PL="$HOME/.config/controlroom/launchd/$lab.plist"
  perl -e 'alarm 15; exec @ARGV' -- launchctl bootout "gui/$(id -u)/$lab" 2>/dev/null && echo "tick      $lab booted out" || echo "tick      $lab was not loaded"
  rm -f "$PL" && echo "          removed $PL"
}
# ---- end 005 ----

# ---- memory (004) ----  docs/briefs/memory/{DECISIONS,LESSONS}.md — append-only, every line `- D### date **slug** — text ← source`
# mem_py <decide|lesson|supersede|memory|land|init|strip> [args…]; data via argv/env (stdin is the heredoc). Design: docs/design/durable-controlroom.md §1, §5.
mem_py(){ ROOT="$ROOT" python3 - "$@" <<'PY'
import os,re,sys,glob,time,datetime
root=os.environ["ROOT"]; mem=os.path.join(root,"docs/briefs/memory"); today=datetime.date.today().isoformat()
cmd,args=sys.argv[1],sys.argv[2:]; FILE={"D":"DECISIONS.md","L":"LESSONS.md"}; BUDGET={"D":40,"L":30}
def die(m): print(m,file=sys.stderr); sys.exit(1)
def path(k): return os.path.join(mem,FILE[k])
def lines(k): return open(path(k)).read().splitlines() if os.path.exists(path(k)) else []
def active(k): return [l for l in lines(k) if re.match(r"^- [DL]\d{3} ",l)]
def proposed():
    p=os.path.join(mem,"proposed.md"); return [l for l in (open(p).read().splitlines() if os.path.exists(p) else []) if re.match(r"^- P\d{3} ",l)]
def over(D,L): return [f"{FILE[k][:-3]} {len(v)}/{BUDGET[k]}" for k,v in (("D",D),("L",L)) if len(v)>BUDGET[k]]
def age(t): d=time.time()-t; return f"{int(d//60)}m" if d<3600 else (f"{d/3600:.1f}h" if d<86400 else f"{d/86400:.1f}d")
def opt(name): return args[args.index(name)+1] if name in args and args.index(name)+1<len(args) else None
def check_src(src,chat_ok=False):   # (012) 011 #8: THE source validator (dream --check shells out to it) → None when it resolves, else why not
    if src.startswith("chat:"): return None if chat_ok else "chat: source — the dreamer never saw the chat (decide/lesson: pass --chat-ok)"
    m=re.match(r'([^#:\s"]+)(?:(#[^\s:"]+)|:"(.*)"|:(\d+))?$',src)
    if not m: return f"unparseable source `{src}`"
    p=os.path.normpath(os.path.join(root,m.group(1)))
    if not p.startswith(root+os.sep) or not os.path.isfile(p): return f"not a file under the repo: {m.group(1)}"
    t=open(p,errors="replace").read()
    if m.group(2) and m.group(2)[1:] not in {re.sub(r"[^\w\- ]","",h.replace("`","").strip().lower()).replace(" ","-") for h in re.findall(r"^#+\s+(.*)$",t,re.M)}: return f"anchor {m.group(2)} is not a heading in {m.group(1)}"
    if m.group(3) is not None and m.group(3) not in t: return f'phrase "{m.group(3)}" not in {m.group(1)}'
    if m.group(4) and int(m.group(4))>t.count("\n")+1: return f"line {m.group(4)} beyond end of {m.group(1)}"
def add(k,text,src,slug):
    if not src: die('refused: no source, no line — add --from <repo/path[#anchor|:line|:"phrase"]> (or --from chat:<ISO-ts> --chat-ok)')
    e=check_src(src,"--chat-ok" in args); e and die("refused: "+e)
    if len(text)>160: die(f"refused: one-liner is {len(text)} chars (max 160)")
    if "\n" in text or "|" in text: die("refused: one-liner must be one line without `|` (the line grammar)")   # (012) 011 #8
    if not os.path.isdir(mem): die("no docs/briefs/memory/ — run: controlroom init")
    slug=slug or "-".join(re.sub(r"[^a-z0-9]+","-",text.lower()).strip("-").split("-")[:4])[:32]
    ids=[int(m.group(1)) for l in lines(k) for m in [re.match(r"^- (?:~~)?%s(\d{3}) "%k,l)] if m]
    line=f"- {k}{max(ids,default=0)+1:03d} {today} **{slug}** — {text} ← {src}"
    with open(path(k),"a") as f: f.write(line+"\n")
    print(line)
SEED=[("no-timeout-binary","no `timeout`/`gtimeout` on this Mac; wrap anything that can hang in `perl -e 'alarm N; exec @ARGV' --`; don't brew-install coreutils","docs/briefs/results/001-mana-install.md#6-gotchas"),
 ("caffeinate-pipelines","laptop sleep kills long jobs and workers' API calls mid-write; run pipelines under `caffeinate -i`, tell workers to save partials early",'README.md:"lost a step to this once"'),
 ("frontmatter-quote-colon","a prompt-template frontmatter value containing `: ` breaks YAML and pi silently skips the template — quote it; `/reload` picks it up",'skills/controlroom/SKILL.md:"must be quoted"'),
 ("heredoc-eats-stdin","piping JSON into `python3 - <<EOF` loses stdin to the heredoc — pass data via an env var (or argv)",'skills/controlroom/SKILL.md:"loses stdin"'),
 ("timebox-local-compute","a worker sat 26 h on one unbounded call at 98 % CPU while the strip said `working` — briefs must time-box compute and demand partial outputs",'skills/controlroom/SKILL.md:"blocked 26 h"'),
 ("hidden-subagents-die","hidden pi subagents are killed after ~3 min without output — use Herdr panes for read-heavy tasks",'README.md:"killed after ~3 minutes"'),
 ("toasts-unreliable","Herdr toasts default to off and are transient; the strip and `logs/agents.log` are the reliable signals",'README.md:"default to *off*"')]
if cmd in ("decide","lesson"):
    pos=[a for i,a in enumerate(args) if not a.startswith("--") and (i==0 or args[i-1] not in ("--from","--slug"))]
    if not pos: die(f'usage: controlroom {cmd} "<one-liner>" --from <source> [--slug s]')
    add("D" if cmd=="decide" else "L",pos[0],opt("--from"),opt("--slug"))
elif cmd=="supersede":
    if len(args)<2 or args[0][:1] not in FILE or args[1][:1] not in FILE: die("usage: controlroom supersede <ID> <byID>   (IDs like D007 / L003)")
    old,new=args[:2]
    if not any(l.startswith(f"- {new} ") for l in lines(new[0])): die(f"{new} not found — it must exist before it can supersede")
    out,hit=[],None
    for l in lines(old[0]):
        if l.startswith(f"- {old} "): body,_,src=l[2:].rpartition(" ← "); hit=l; l=f"- ~~{body}~~ superseded-by {new} ← {src}"
        out.append(l)
    if not hit: die(f"{old} not found or already struck")
    open(path(old[0]),"w").write("\n".join(out)+"\n"); os.makedirs(os.path.join(mem,"archive"),exist_ok=True)
    with open(os.path.join(mem,"archive",today[:7]+".md"),"a") as f: f.write(f"{hit}  · superseded-by {new} {today}\n")
    print(f"{old} struck, superseded-by {new} · archived to memory/archive/{today[:7]}.md")
elif cmd=="memory":
    if "--check-src" in args: e=check_src(opt("--check-src") or ""); print(e or ""); sys.exit(1 if e else 0)   # (012) used by dream --check
    if not os.path.isdir(mem): die("no docs/briefs/memory/ — run: controlroom init")
    D,L,P=active("D"),active("L"),proposed(); ov=over(D,L)
    counts=f"{len(D)} decisions · {len(L)} lessons · {len(P)} proposed"+(f"   ⚠ over budget: {', '.join(ov)}" if ov else "")
    if "--counts" in args: print(counts); sys.exit()
    if "--unsourced" in args: print("\n".join(l for l in D+L if "← chat:" in l) or "(none unsourced)"); sys.exit()
    if "--decisions" in args: print("\n".join(D) or "(no decisions)"); sys.exit()
    if "--lessons" in args: print("\n".join(L) or "(no lessons)"); sys.exit()
    room=66; kL=min(len(L),max(room//2,room-len(D))); kD=min(len(D),room-kL)   # ≤ 70 lines total
    print(counts); print("\n".join(D[len(D)-kD:]) or "(no decisions)")
    if kD<len(D): print(f"  … {len(D)-kD} older decisions hidden (controlroom memory --decisions)")
    print(); print("\n".join(L[len(L)-kL:]) or "(no lessons)")
    if kL<len(L): print(f"  … {len(L)-kL} older lessons hidden (controlroom memory --lessons)")
elif cmd=="strip":   # one line for status_text; silent when memory/ is absent
    if not os.path.isdir(mem): sys.exit()
    D,L=active("D"),active("L"); mts=[os.path.getmtime(path(k)) for k in "DL" if os.path.exists(path(k))]; dr=glob.glob(os.path.join(mem,"dreams","*.md"))
    print(f" MEMORY  {len(D)} decisions · {len(L)} lessons · newest {age(max(mts))+' ago' if mts else '—'} · {len(proposed())} proposed · last dream {age(max(map(os.path.getmtime,dr))) if dr else 'never'}"+("   \033[33m⚠ over budget\033[0m" if over(D,L) else ""))
elif cmd=="init":
    made=[]
    for d in (mem,os.path.join(mem,"archive"),os.path.join(mem,"dreams")):
        if not os.path.isdir(d): os.makedirs(d); made.append(os.path.basename(d)+"/")
    for n,h in (("DECISIONS.md","what we chose · `controlroom decide \"…\" --from <source>`"),("LESSONS.md","what bit us and the rule we adopted · `controlroom lesson \"…\" --from <source>`"),("proposed.md","written by `controlroom dream`; promote or reject — never edit by hand")):
        p=os.path.join(mem,n)
        if not os.path.exists(p): open(p,"w").write(f"# {n[:-3]} — {h}. Append-only; grammar: `- {n[0].upper()}### YYYY-MM-DD **slug** — one-liner ← source`\n\n"); made.append(n)
    v=os.path.join(mem,".version"); os.path.exists(v) or open(v,"w").write("1\n")
    print("memory/   "+("created "+" ".join(made) if made else "present (skipped)"))
    if "--no-seed" not in args:
        have={m.group(1) for l in lines("L") for m in [re.search(r"\*\*([^*]+)\*\*",l)] if m}; new=[s for s in SEED if s[0] not in have]
        for slug,text,src in new: add("L",text,src,slug)
        print(f"          seeded {len(new)} L-lines from skills/controlroom/SKILL.md Gotchas + README (--no-seed to skip)" if new else "          LESSONS already seeded (skipped)")
elif cmd=="land":
    sp=os.path.join(root,"docs/briefs/STATUS.md")
    if not os.path.exists(sp): die("no docs/briefs/STATUS.md")
    src=open(sp).read().splitlines(); out,moved,dropped,sec,i,filt=[],[],[],"",0,set(args)
    while i<len(src):
        l=src[i]
        if l.startswith("## "): sec=l[3:].strip().lower()
        if sec.startswith("workers") and l.startswith("|"):
            c=[x.strip() for x in l.strip().strip("|").split("|")]
            if len(c)>=5 and c[3].lower().startswith("done") and "](" in c[4] and (not filt or filt&{c[1],c[2]}): moved.append(c); i+=1; continue
        if sec.startswith("decisions waiting") and re.match(r"^\d+\.\s*~~",l):
            j=i+1
            while j<len(src) and src[j].strip() and not re.match(r"^\d+\.",src[j]) and not src[j].startswith("## "): j+=1
            dropped.append(" ".join(x.strip() for x in src[i:j])); i=j; continue
        out.append(l); i+=1
    if not moved and not dropped: print("land: nothing to move (no `done` rows with a result link, no struck decisions)"); sys.exit()
    n=0; sec=""
    for k,l in enumerate(out):   # renumber the remaining decisions
        if l.startswith("## "): sec=l[3:].lower(); n=0
        if sec.startswith("decisions waiting") and re.match(r"^\d+\.",l): n+=1; out[k]=re.sub(r"^\d+\.",f"{n}.",l)
    if moved:
        if not any(l.strip()=="## Landed" for l in out): out+=["","## Landed","| when | brief | worker | result | one-liner |","|---|---|---|---|---|"]
        at=next(k for k,l in enumerate(out) if l.strip()=="## Landed")+3   # after header + separator → newest first
        rows=[]
        for c in moved: res,_,one=c[4].partition(" — "); rows.append(f"| {datetime.date.today():%m-%d} | {c[2]} | {c[1]} | {res} | {one or '—'} |")
        out[at:at]=rows
    cites=[l.split()[1] for k in "DL" for l in active(k) if "STATUS.md" in l.rpartition(" ← ")[2]]   # (012) 011 #9
    if cites: print(f"⚠ {', '.join(cites)} cite STATUS.md — the board is being rewritten; re-point them to memory/archive/{today[:7]}.md (dream --check flags dead phrases)")
    tmp=sp+".tmp"; open(tmp,"w").write("\n".join(out)+"\n"); os.replace(tmp,sp)
    if dropped:   # the struck board item is the source a D-line cites; keep its text — (012) 011 #9: always, even without memory/
        os.makedirs(os.path.join(mem,"archive"),exist_ok=True)
        with open(os.path.join(mem,"archive",today[:7]+".md"),"a") as f: f.write("".join(f"- board {today} (dropped by land): {d}\n" for d in dropped))
    for c in moved: print(f"landed  {c[1]:<18} {c[2]}  ({c[3]})")
    for d in dropped: print(f"dropped decided: {d[:120]}")
else: die(f"mem_py: unknown {cmd}")
PY
}
# ---- end memory ----

# ---- dream (007) ----  propose-only consolidation: prompts/dream.md → memory/.dream-brief.md → `dreamer-N` worker (via launch) · `dream --check` (no LLM) · `promote` · `reject`. Design §3.
# dream_py <render|check|promote|reject> [args…]; data via argv/env (stdin is the heredoc). State: memory/.dream-pre.json (stamp, since, max P id, guarded mtimes) written at render, read by check.
dream_py(){ ROOT="$ROOT" SELF="$0" LOG="$LOG" python3 - "$@" <<'PY'
import os,re,sys,glob,json,time,subprocess,datetime as dt
ROOT=os.environ["ROOT"]; SELF=os.environ["SELF"]; MEM=os.path.join(ROOT,"docs/briefs/memory"); DR=os.path.join(MEM,"dreams"); PROP=os.path.join(MEM,"proposed.md"); PRE=os.path.join(MEM,".dream-pre.json")
cmd,args=sys.argv[1],sys.argv[2:]; NOW=dt.datetime.now(); today=NOW.strftime("%Y-%m-%d")
GUARD=["docs/briefs/memory/DECISIONS.md","docs/briefs/memory/LESSONS.md","docs/briefs/STATUS.md"]+sorted(os.path.relpath(f,ROOT) for f in glob.glob(os.path.join(ROOT,"docs/briefs/results/*.md")))
LINE=re.compile(r"^- (~~)?([DLP]\d{3}) (\d{4}-\d\d-\d\d) \*\*([^*]+)\*\* — (.*?)(?:~~ ([^←]*?))? ← (.*)$")
def die(m): print(m,file=sys.stderr); sys.exit(1)
def rd(p): return open(p).read() if os.path.exists(p) else ""
def mt(rel): p=os.path.join(ROOT,rel); return os.path.getmtime(p) if os.path.exists(p) else None
def opt(k,d=None): return args[args.index(k)+1] if k in args and args.index(k)+1<len(args) else d
def reports(): return sorted(glob.glob(os.path.join(DR,"*.md")),key=os.path.getmtime)
def parse(l):
    m=LINE.match(l); return m and dict(struck=bool(m.group(1)),id=m.group(2),date=m.group(3),slug=m.group(4),text=m.group(5),src=m.group(7).strip())
def allp(): return [d for f in ("DECISIONS.md","LESSONS.md","proposed.md") for d in map(parse,rd(os.path.join(MEM,f)).splitlines()) if d]
def plines(): return [d for d in map(parse,rd(PROP).splitlines()) if d and d["id"][0]=="P" and not d["struck"]]
def check_src(src):   # → None when the citation resolves, else why not. (012) 011 #8: one validator — mem_py's check_src, via `controlroom memory --check-src`
    return subprocess.run([SELF,"memory","--check-src",src],capture_output=True,text=True,env=dict(os.environ,ROOT=ROOT),cwd=ROOT).stdout.strip() or None
def strike(pid,tag):   # strike one active P-line in proposed.md in place → the parsed line, or None
    out,hit=[],None
    for l in rd(PROP).splitlines():
        d=parse(l)
        if d and d["id"]==pid and not d["struck"]: hit=d; l=f"- ~~{pid} {d['date']} **{d['slug']}** — {d['text']}~~ {tag} ← {d['src']}"
        out.append(l)
    if hit: tmp=PROP+".tmp"; open(tmp,"w").write("\n".join(out)+"\n"); os.replace(tmp,PROP)
    return hit
def note(t,b,s="request"): subprocess.run(["bash","-c",f'cd "$ROOT" && source "{SELF}" __lib__ 2>/dev/null; note "$@"',"_",t,b,s],env=dict(os.environ,ROOT=ROOT),timeout=20)
if cmd=="render":   # render <reason> <since|7d|""> → memory/.dream-brief.md + .dream-pre.json; prints "<brief> <stamp> <since>"
    reason=args[0] or "manual"; since=args[1] if len(args)>1 else ""
    if re.match(r"^\d+d$",since): s=NOW-dt.timedelta(days=int(since[:-1]))
    elif since: s=dt.datetime.strptime(since[:16].replace(" ","T"),"%Y-%m-%dT%H:%M")
    else: r=reports(); s=dt.datetime.fromtimestamp(os.path.getmtime(r[-1])) if r else NOW-dt.timedelta(days=7)
    since=s.strftime("%Y-%m-%dT%H:%M"); stamp=NOW.strftime("%Y-%m-%d-%H%M")
    tp=os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(SELF)),"..","prompts","dream.md")); t=rd(tp) or die(f"template not found: {tp}")
    t=re.sub(r"\A---\n.*?\n---\n","",t,flags=re.S)   # drop the pi frontmatter; the CLI fills the placeholders (it knows ROOT, the last-dream mtime and the stamp; a model guessing them would break --check)
    for k,v in (("{ROOT}",ROOT),("{reason}",reason),("{since}",since),("{stamp}",stamp)): t=t.replace(k,v)
    t=re.sub(r"\$\{1:-[^}]*\}",reason,t); t=re.sub(r"\$\{2:-[^}]*\}",since,t)
    if not os.path.isdir(MEM): die("no docs/briefs/memory/ — run: controlroom init --memory-only")
    os.makedirs(DR,exist_ok=True); bp=os.path.join(MEM,".dream-brief.md")
    open(bp,"w").write(f"<!-- rendered by `controlroom dream` {NOW:%Y-%m-%d %H:%M} from prompts/dream.md (stamp {stamp}) — do not edit; re-run controlroom dream -->\n"+t)
    json.dump(dict(stamp=stamp,reason=reason,since=since,started=time.time(),p_max=max([int(d["id"][1:]) for d in allp() if d["id"][0]=="P"]+[0]),mtimes={g:mt(g) for g in GUARD}),open(PRE,"w"))
    print(f"{os.path.relpath(bp,ROOT)} {stamp} {since}")
elif cmd=="check":   # newest dreams/*.md + proposed.md, no LLM: citations resolve · DONE dream · count matches · no dup slug · ≤10 · guarded files unmoved (warn)
    r=reports() or die("dream --check: no report in docs/briefs/memory/dreams/"); rep=r[-1]; rt=rd(rep); rel=os.path.relpath(rep,ROOT); pre=json.loads(rd(PRE) or "{}"); fails,warn=[],[]
    if not re.search(r"^\s*DONE dream\s*$",rt,re.M): fails.append(f"{rel}: no `DONE dream` line")
    pmax=pre.get("p_max") if pre.get("stamp","∅") in os.path.basename(rep) else None   # P-lines of *this* run: ids above the pre-render max; fallback: same date as the report
    sec=lambda n: (re.search(r"^## "+n+r"[^\n]*\n(.*?)(?=^## |\Z)",rt,re.M|re.S) or [None,""])[1]
    echoed=set(re.findall(r"^- (?:~~)?(P\d{3}) ",sec("Proposed"),re.M)); mine=lambda d: int(d["id"][1:])>pmax if pmax is not None else d["id"] in echoed   # older report: the IDs it echoes
    run=[d for d in allp() if d["id"][0]=="P" and mine(d)]; new=[d for d in run if not d["struck"]]   # run = this dream's lines incl. already promoted/rejected; new = still open
    m=re.search(r"^## Proposed \((\d+)\)",rt,re.M)
    if not m: fails.append(f"{rel}: no `## Proposed (N)` heading")
    elif int(m.group(1))!=len(run): fails.append(f"{rel}: heading says {m.group(1)} proposed, proposed.md gained {len(run)} P-line(s) ({', '.join(d['id'] for d in run) or 'none'})")
    if len(run)>10: fails.append(f"{len(run)} P-lines this run (max 10)")
    S={}
    for d in allp(): S.setdefault(d["slug"],[]).append(d["id"])
    for d in new:
        e=check_src(d["src"]); e and fails.append(f"{d['id']}: {e}")
        o=[i for i in S[d["slug"]] if i!=d["id"]]; o and fails.append(f"{d['id']}: duplicate slug **{d['slug']}** (also {', '.join(o)})")
        if not re.match(r"^\[[DL]\] ",d["text"]): warn.append(f"{d['id']}: no [D]/[L] tag — promote will need --kind")
        if len(d["text"])>165: fails.append(f"{d['id']}: one-liner is {len(d['text'])} chars (max 160 + tag)")
    for src in sorted(set(re.findall(r'← ([^\s"#:]+(?:#[^\s:"]+|:"[^"]*"|:\d+)?)',rt))):   # citations inside the report itself (P-lines echoed, merge/unsure bullets)
        e=check_src(src); e and fails.append(f"{rel}: {e}")
    cnt=lambda n: len([l for l in sec(n).splitlines() if re.match(r"^\s*(?:[-*]|\d+\.)\s+\S",l) and not re.match(r"^\s*(?:[-*]|\d+\.)\s+\(?(?:none|—|n/a|nothing)\b",l,re.I)])
    for g,t0 in pre.get("mtimes",{}).items():
        t1=mt(g)
        if (t1 or 0)!=(t0 or 0): warn.append(f"moved during the dream: {g} ({'deleted' if t1 is None else 'modified '+dt.datetime.fromtimestamp(t1).strftime('%H:%M')}) — the dreamer must not edit it; confirm it was you")
    warn+=[f"new during the dream: {g}" for g in GUARD if pre.get("mtimes") and g not in pre["mtimes"]]
    dur=(os.path.getmtime(rep)-pre["started"])/60 if pre.get("started") and pmax is not None else None
    if dur and dur>15: warn.append(f"took {dur:.0f} min (time-box 15)")
    for d in new: print(f"  {d['id']} **{d['slug']}** — {d['text'][:90]} ← {d['src']}")
    for w in warn: print(f"  ⚠ {w}")
    summary=f"{len(run)} proposed, {cnt('Merge candidates')} merges, {cnt('Landed candidates')} landed-candidates"+(f" ({len(new)} still open)" if len(new)!=len(run) else "")
    if fails:
        print(f"dream --check FAILED · {rel} · {len(fails)} problem(s):"); [print(f"  ✗ {f}") for f in fails]
        link=any(k in f for f in fails for k in ("not found","not in ","not a heading","unparseable","beyond end"))
        note("dream report has dead links" if link else "dream report failed --check",f"{len(fails)} problem(s) in {rel} — controlroom dream --check"); sys.exit(1)
    if f"dream ok: {summary} · {rel}" not in rd(os.environ["LOG"]): open(os.environ["LOG"],"a").write(f"[{NOW:%m-%d %H:%M}] dream ok: {summary} · {rel}\n")   # re-runs don't re-log
    print(f"dream ok: {summary} · {rel}"+(f" · {dur:.0f} min" if dur is not None else "")+" → controlroom promote P### | reject P### [why]")
elif cmd=="promote":   # promote P### [P### …] | --all [--kind D|L]: [D]/[L] tag picks the file; --kind = default for untagged (and, with --all, a filter)
    kind=opt("--kind"); ids=[a for a in args if re.match(r"^P\d{3}$",a)]
    if "--all" in args: ids=[d["id"] for d in plines()]
    if not ids or (kind and kind not in "DL"): die("usage: controlroom promote P### [P### …] | --all [--kind D|L]   (nothing to promote)" if not ids else "--kind must be D or L")
    bad=0
    for pid in ids:
        d=next((x for x in plines() if x["id"]==pid),None); bad+=1
        if not d: print(f"{pid}: not found or already struck"); continue
        m=re.match(r"^\[([DL])\]\s*(.*)$",d["text"]); k=kind if kind and "--all" not in args else ((m.group(1) if m else None) or kind); text=m.group(2) if m else d["text"]   # named + --kind overrides the tag
        if "--all" in args and kind and m and m.group(1)!=kind: continue
        if not k: print(f"{pid}: no [D]/[L] tag — pass --kind D|L"); continue
        dup=[x["id"] for x in allp() if x["slug"]==d["slug"] and x["id"][0] in "DL" and not x["struck"]]
        if dup: print(f"{pid}: refused — slug **{d['slug']}** already in memory as {', '.join(dup)} (reject it, or supersede)"); continue
        r=subprocess.run([SELF,"decide" if k=="D" else "lesson",text,"--from",d["src"],"--slug",d["slug"]],capture_output=True,text=True,env=dict(os.environ,ROOT=ROOT),cwd=ROOT)
        if r.returncode or not r.stdout.startswith("- "): print(f"{pid}: {(r.stderr or r.stdout).strip()}"); continue
        nid=r.stdout.split()[1]; strike(pid,f"promoted-as {nid}"); print(f"{pid} → {r.stdout.strip()}"); bad-=1
    sys.exit(1 if bad and "--all" not in args else 0)   # named P-lines that were not promoted → rc 1; --all skips are not failures
elif cmd=="reject":   # reject P### [reason]: strike in place + copy to archive/YYYY-MM.md
    pid=args[0] if args and re.match(r"^P\d{3}$",args[0]) else die("usage: controlroom reject P### [reason]"); reason=" ".join(args[1:]) or "no reason given"
    d=strike(pid,f"rejected: {reason}") or die(f"{pid}: not found or already struck")
    os.makedirs(os.path.join(MEM,"archive"),exist_ok=True)
    with open(os.path.join(MEM,"archive",today[:7]+".md"),"a") as f: f.write(f"- {pid} {d['date']} **{d['slug']}** — {d['text']} ← {d['src']}  · rejected {today}: {reason}\n")
    print(f"{pid} rejected: {reason} · archived to memory/archive/{today[:7]}.md")
else: die(f"dream_py: unknown {cmd}")
PY
}
# ---- end dream ----

# ---- rooms (015): one picture across machines ----  `herdr machine list` → per machine `herdr --machine <label> agent list`, ≤ 3 s total, cached in
# logs/.machines-cache.json (the tick refreshes it every pass and logs [label] worker transitions; the strip refreshes it only when it is > 60 s old).
# rooms_py <refresh [--force] [--quiet] | header | agents | machines>; data via env (AGENTS_JSON, DETAIL, WS) — stdin is the heredoc.
rooms_py(){ ROOT="$ROOT" SELF="$0" WS="$WS" LOG="$LOG" DETAIL="${DETAIL:-0}" AGENTS_JSON="${AGENTS_JSON:-}" python3 - "$@" <<'PY'
import json,os,re,socket,subprocess,sys,time
from concurrent.futures import ThreadPoolExecutor
ROOT=os.environ["ROOT"]; SELF=os.environ["SELF"]; WS=os.environ.get("WS") or None; LOGS=os.path.join(ROOT,"logs"); LOG=os.environ["LOG"]
MC=os.path.join(LOGS,".machines-cache.json"); CTRL=os.path.join(LOGS,".controller"); STATUS=os.path.join(ROOT,"docs/briefs/STATUS.md")
BUDGET=float(os.environ.get("CONTROLROOM_MACHINES_BUDGET",3)); TTL=float(os.environ.get("CONTROLROOM_MACHINES_TTL",60))
now=time.time(); cmd,args=sys.argv[1],sys.argv[2:]
RED,YEL,GRN,CYN,DIM,BOLD,OFF="\033[31;1m","\033[33m","\033[32m","\033[36m","\033[90m","\033[1m","\033[0m"
COL={"working":YEL,"idle":GRN,"done":"\033[32;1m","blocked":RED,"crashed":RED,"stalled":"\033[35m","unknown":DIM,"stuck?":RED,"spinning?":YEL}
def hhmm(t): return time.strftime("%H:%M",time.localtime(t)) if t else "?"
def sh(c,timeout):
    try: return subprocess.run(c,capture_output=True,text=True,timeout=timeout).stdout
    except Exception: return ""
def machines():   # saved + enabled `herdr machine` rows → [{label,target}]
    try: ms=json.loads(sh(["herdr","machine","list","--json"],2) or "[]")
    except Exception: ms=[]
    return [m for m in ms if isinstance(m,dict) and m.get("label") and m.get("enabled",True)]
def load():
    try: return json.load(open(MC))
    except Exception: return {"machines":{},"updated":0}
def save(c): os.makedirs(LOGS,exist_ok=True); json.dump(c,open(MC+".tmp","w")); os.replace(MC+".tmp",MC)
def board():   # STATUS.md head: `MODE: local|remote|<label>` · `controller: <name>` / `controller (<label>): <name>` · last `## HANDOFF <t>`
    mode=None; ctls={}; handoff=None
    try: txt=open(STATUS).read()
    except Exception: return mode,ctls,handoff
    m=re.search(r"MODE:\**\s*`?(\w[\w-]*)",txt); mode=m.group(1).lower() if m else None
    for m in re.finditer(r"^\W{0,3}controller(?:\s*\(([^)]+)\))?:\**\s*`?([\w.-]+)`?",txt,re.M|re.I): ctls[(m.group(1) or "local").lower()]=m.group(2)
    hs=re.findall(r"^## HANDOFF\s+(.+)$",txt,re.M); handoff=hs[-1].strip()[:16] if hs else None
    return mode,ctls,handoff
def is_ctl(n,host="local",ctls={}):   # a controller: the board's `controller:` field for that host, or the naming convention
    n=n or ""; return bool(n) and (n==ctls.get(host) or n=="controller" or n.startswith("controller-") or n.endswith("-controller") or n.endswith("-remote"))
def refresh(force=False,quiet=False):
    c=load(); ms=machines(); labels={m["label"] for m in ms}
    c["machines"]={k:v for k,v in c.get("machines",{}).items() if k in labels}
    if not ms: c["updated"]=now; save(c); return c
    if not force and now-c.get("updated",0)<TTL: return c
    deadline=now+BUDGET
    def q(m):
        try: r=subprocess.run(["herdr","--machine",m["label"],"agent","list"],capture_output=True,text=True,timeout=max(0.5,deadline-time.time()))
        except subprocess.TimeoutExpired: return m,None,"timeout"
        except Exception as e: return m,None,str(e)[:60]
        try: return m,json.loads(r.stdout)["result"]["agents"],None
        except Exception: return m,None,((r.stderr.strip().splitlines() or ["no json"])[-1])[:60]
    with ThreadPoolExecutor(max_workers=max(1,len(ms))) as ex: res=list(ex.map(q,ms))
    events=[]
    for m,ags,err in res:
        lab=m["label"]; old=c["machines"].get(lab,{})
        if ags is None:   # unreachable: keep last known agents (greyed on the strip), remember since when
            e=dict(old); e.update(target=m.get("target",""),reachable=False,err=err,since=old.get("since") if old.get("reachable") is False else now); e.setdefault("agents",[]); c["machines"][lab]=e; continue
        new=[{k:a.get(k) for k in ("name","pane_id","agent_status","workspace_id","tab_id")} for a in ags if a.get("name")]
        oldst={a.get("name"):a.get("agent_status") for a in old.get("agents",[])}
        for a in new:   # transitions → EVENTS (controllers excluded: they go idle after every prompt)
            n=a["name"]; st=a["agent_status"]; prev=oldst.get(n)
            if is_ctl(n,lab) or prev is None or prev==st: continue
            if st=="blocked": events.append((f"[{lab}] worker {n} NEEDS YOU",f"herdr --machine {lab} agent focus {n}","request"))
            elif prev=="working" and st in ("done","idle"): events.append((f"[{lab}] worker {n}: finished ({st})",f"controlroom verify {lab}/{n} · results are in the remote clone","done"))
        if old and old.get("reachable") is False: events.append((f"[{lab}] reachable again",f"down {max(1,int((now-(old.get('since') or now))//60))}m","done"))
        c["machines"][lab]={"target":m.get("target",""),"reachable":True,"since":old.get("since") if old.get("reachable") else now,"last_ok":now,"agents":new,"err":None}
    c["updated"]=now; save(c)
    for t,b,s in events: subprocess.run(["bash","-c",f'cd "$ROOT" && source "{SELF}" __lib__ 2>/dev/null; note "$@"',"_",t,b,s],env=dict(os.environ,ROOT=ROOT),timeout=10)
    if not quiet:
        for lab,e in c["machines"].items(): print(f"{lab:<12} {'reachable' if e['reachable'] else 'unreachable ('+str(e.get('err'))+')'} · {len(e.get('agents',[]))} agents · since {hhmm(e.get('since'))}")
    return c
def sync_line():   # local git vs origin (no fetch) — cheap and honest about what we know
    head=sh(["git","-C",ROOT,"rev-parse","--short","HEAD"],3).strip(); ab=sh(["git","-C",ROOT,"rev-list","--left-right","--count","HEAD...@{u}"],3).split()
    s=f"HEAD {head}" if head else ""
    if len(ab)==2: s+=f" · ahead {ab[0]} · behind {ab[1]} (origin, last fetch)"
    return s
if cmd=="refresh": refresh("--force" in args,"--quiet" in args)
elif cmd=="machines":
    for lab,e in load().get("machines",{}).items(): print(json.dumps({"label":lab,**e}))
elif cmd in ("header","agents"):
    try: ags=json.loads(os.environ.get("AGENTS_JSON") or "{}")["result"]["agents"]
    except Exception: ags=[]
    detail=os.environ.get("DETAIL")=="1"; mode,ctls,handoff=board(); c=load()
    if c.get("updated",0)<now-TTL: c=refresh(quiet=True)   # no tick running → the strip keeps the cache warm itself
    ms=c.get("machines",{}); pid=open(CTRL).read().strip() if os.path.exists(CTRL) else ""
    local=[a for a in ags if not WS or a.get("workspace_id")==WS]
    def lctl(a): return a["pane_id"]==pid or is_ctl(a.get("name"),"local",ctls)
    primary="local" if mode in (None,"local") else (mode if mode in ms else (next(iter(ms)) if mode=="remote" and len(ms)==1 else None))
    rctl={lab:next((a["name"] for a in e.get("agents",[]) if is_ctl(a["name"],lab,ctls)),ctls.get(lab)) for lab,e in ms.items()}
    import shutil
    try: W=int(os.environ.get("COLUMNS") or 0) or shutil.get_terminal_size((120,20)).columns
    except Exception: W=120
    W=max(40,W); NOCOL=bool(os.environ.get("NO_COLOR"))
    strip=lambda t: re.sub(r"\x1b\[[0-9;]*m","",t)
    def vlen(t): return len(strip(t))
    def cut(t,w):   # truncate a styled line to w visible columns (keeps escapes, appends OFF)
        out=""; n=0
        for part in re.split(r"(\x1b\[[0-9;]*m)",t):
            if part.startswith("\x1b"): out+=part; continue
            take=part[:max(0,w-n)]; out+=take; n+=len(take)
            if n>=w: break
        return out+("" if NOCOL else OFF)
    if NOCOL: RED=YEL=GRN=CYN=DIM=BOLD=OFF=""; COL.clear()
    ACC={"local":"34","remote":"32","down":"31","":"34"}   # theme-adaptive FOREGROUND accents only (basic blue/green/red) — never a background fill: those fight light themes
    FAINT="\033[2m"
    def acc(kind,bold=False,dim=False): return "" if NOCOL else f"\033[{'1;' if bold else ('2;' if dim else '')}{ACC[kind]}m"
    def bar(kind,host,rest):   # `▌ LOCAL · Mac · 14 agents ──────` : ▌ + host name in the accent, rest default, thin dim rule to the width; NO_COLOR → the same without escapes
        head=f"▌ {host}"+(f" · {rest}" if rest else "")+" "; rule="─"*max(0,W-vlen(head)-1)
        if NOCOL: return f"{head}{rule}"
        return f"{acc(kind)}▌{OFF} {acc(kind,bold=True)}{host}{OFF}"+(f" · {rest}" if rest else "")+f" {FAINT}{rule}{OFF}"
    def gutter(kind,ctl): return ("▶" if ctl else "│") if NOCOL else (f"{acc(kind,bold=True)}▶{OFF}" if ctl else f"{acc(kind,dim=True)}│{OFF}")
    def chip(kind): return "‹PRIMARY›" if NOCOL else f"{acc(kind,bold=True)}‹PRIMARY›{OFF}"
    if cmd=="header":
        if not ms: sys.exit(0)
        lc=next((a.get("name") or a["pane_id"] for a in local if lctl(a)),ctls.get("local") or "—")
        parts=[f"local {acc('local',bold=True)}▶{OFF}{lc}"+(f" {chip('local')}" if primary=="local" else "")]
        for lab in ms: parts.append(f"{lab} {acc('remote' if ms[lab].get('reachable') else 'down',bold=True)}▶{OFF}{rctl.get(lab) or '—'}"+(f" {chip('remote')}" if primary==lab else "")+("" if ms[lab].get("reachable") else f" {RED}unreachable{OFF}"))
        rooms=f" ROOMS  {' ⇄ '.join(parts)} · MODE: {mode or '— (no MODE: line)'}"; sync=f"sync: {sync_line() or 'not a git checkout'}"+(f" · last HANDOFF {handoff}" if handoff else "")
        if vlen(rooms)+3+len(sync)<=W: print(f"{rooms} · {DIM}{sync}{OFF}")
        else: print(cut(rooms,W)); print(cut(f"        {DIM}{sync}{OFF}",W))   # (015 §7) sync drops to its own dim line when the first doesn't fit
        sys.exit(0)
    # ---- AGENTS ----
    tasks={}
    try:
        for line in open(STATUS):
            cells=[x.strip() for x in line.strip().strip("|").split("|")]
            if len(cells)>=3 and cells[1] and cells[1] not in ("agent","---"): tasks[cells[1]]=cells[2]
    except Exception: pass
    try: H=json.load(open(os.path.join(LOGS,".health.json"))).get("agents",{})   # written by `controlroom tick` / `health` (005)
    except Exception: H={}
    def lastline(n):
        try: return subprocess.run([SELF,"lastline",n],capture_output=True,text=True,timeout=5).stdout.strip()
        except Exception: return ""
    DONE_MAX=int(os.environ.get("CR_STRIP_DONE_MAX",3))
    def row(kind,st,n,pane,ctl,prim,dim=False,extra=""):
        c=DIM if dim else COL.get(st,"")
        lead=f"  {gutter(kind,ctl)}  " if kind else ("  ▶" if ctl else "   ")   # grouped: gutter glyph in the group accent, text at col 5 · flat (single machine): the old layout
        print(cut(f"{lead}{c}{st:<8}{OFF} {DIM if dim else ''}{n:<18} {pane}{OFF}"+(f" {chip(kind or 'local')}" if prim else "")+extra,W))
    def render(kind,rows):   # controllers → non-done (working/blocked/stalled/idle/…) → at most DONE_MAX done + `… +K done`; so a remote group always fits on a short strip
        ctl=[r for r in rows if r["ctl"]]; live=[r for r in rows if not r["ctl"] and r["st"]!="done"]; done=[r for r in rows if not r["ctl"] and r["st"]=="done"]
        for r in ctl+live+done[:DONE_MAX]:
            row(kind,r["st"],r["n"],r["pane"],r["ctl"],r["prim"],r.get("dim",False),r.get("extra",""))
            if r.get("ll"): print(cut(f"            {CYN}→ {r['ll']}{OFF}",W))
        if len(done)>DONE_MAX: print(cut(f"  {gutter(kind,False) if kind else ' '}  {DIM}… +{len(done)-DONE_MAX} done  ({', '.join(r['n'] for r in done[DONE_MAX:])}){OFF}",W))
    print(" AGENTS"+("  (detail on — Ctrl+B D to toggle)" if detail else "  (Ctrl+B D for detail)")+("  ▶ = controller" if ms else ""))
    if ms: print(bar("local",f"LOCAL · {socket.gethostname().split('.')[0]}",f"{len(local)} agents"))
    rows=[]
    for a in local:
        n=a.get("name") or a["pane_id"]; st=a["agent_status"]; h=H.get(n,{})
        if st=="working" and h.get("flag"): st=h["flag"]
        if st in ("done","idle") and a.get("name") and not lctl(a):   # (015) controllers are exempt: idle after talking to the human ≠ a stalled worker
            try: v=subprocess.run(["bash","-c",f'source "{SELF}" __lib__ 2>/dev/null; verify "$1"',"_",n],capture_output=True,text=True,timeout=4).stdout.strip()   # (012) 011 #13: name as argv
            except Exception: v=""
            st={"done":"done","crashed":"crashed","stalled":"stalled"}.get(v,st)
        ex=(f"   {DIM}{tasks.get(n,'')[:90]}{OFF}" if detail and tasks.get(n) else "")+(f"   {DIM}last write {h['last_write']} · ctx {h.get('ctx_pct','?')}%{OFF}" if detail and h.get("last_write") else "")
        rows.append(dict(st=st,n=n,pane=a["pane_id"],ctl=lctl(a),prim=lctl(a) and primary=="local",extra=ex,ll=lastline(n) if detail and st in ("working","stuck?","spinning?") else ""))
    render("local" if ms else "",rows)
    if not local and not ms: print("   (no agents in this workspace)")
    for lab,e in ms.items():   # one group per saved machine, always rendered; pane ids as on that machine (the bar names it); unreachable → red bar, last-known agents greyed
        ag=e.get("agents",[]); ok=e.get("reachable"); kind="remote" if ok else "down"
        print(); print(bar(kind,lab.upper(),(f"reachable · {len(ag)} agents" if ok else f"{RED}unreachable{OFF} since {hhmm(e.get('since'))}{' · '+e['err'] if e.get('err') else ''}"+(" · last known:" if ag else ""))))
        render(kind,[dict(st=a["agent_status"],n=a["name"],pane=a["pane_id"],ctl=is_ctl(a["name"],lab,ctls),prim=is_ctl(a["name"],lab,ctls) and primary==lab,dim=not ok,extra=(f"   {DIM}{tasks.get(a['name'],'')[:90]}{OFF}" if detail and tasks.get(a["name"]) else "")) for a in ag])
        if not ag and ok: print(f"  {gutter(kind,False)}  {DIM}(no named agents){OFF}")
    if ms: print()
else: print(f"rooms_py: unknown {cmd}",file=sys.stderr); sys.exit(1)
PY
}
# ---- end rooms ----

case "$CMD" in
  __lib__) return 0 2>/dev/null || exit 0 ;;   # sourced for verify()
  verify) [ -n "${1:-}" ] || { echo "usage: controlroom verify <agent>"; exit 2; }; verify "$1" ;;   # (012) 011 #16
  status) status_text ;;
  machines)   # controlroom machines [--refresh] — (015) the remote-machine cache (logs/.machines-cache.json) as JSON lines; --refresh queries `herdr --machine <label> agent list` now (≤ 3 s total)
    case " $* " in *" --refresh "*) rooms_py refresh --force;; *) rooms_py machines;; esac ;;
  detail) if [ -f "$DETAIL_FLAG" ]; then rm -f "$DETAIL_FLAG"; echo "detail: off"; else touch "$DETAIL_FLAG"; echo "detail: on"; fi ;;
  detail-on) touch "$DETAIL_FLAG" ;;
  detail-off) rm -f "$DETAIL_FLAG" ;;
  statusbar)   # curses pager: keeps your scroll position, refreshes only after 15 s of no input. q/ctrl+c quits.
    if [ "$(uname)" != Darwin ] && [ -d "$ROOT/docs/briefs" ]; then   # no launchd → tick loop rides along with the pager (005) — unless one is already beating (015: strip-check relaunches the pager; don't stack loops)
      hb=$(cat "$ROOT/logs/.tick.last" 2>/dev/null | cut -d' ' -f1); [ -n "$hb" ] && [ $(( $(date +%s) - hb )) -lt 180 ] || { "$0" tick --loop >/dev/null 2>&1 & }
    fi
    exec controlroom-pager ;;
  init)
    MEMFLAGS=""; for a in "$@"; do case "$a" in --no-seed|--memory-only) MEMFLAGS="$MEMFLAGS $a";; esac; done   # memory (004)
    case "$MEMFLAGS" in *memory-only*) mem_py init $MEMFLAGS; exit $?;; esac                                # memory (004): scaffold only, no pane/agent changes
    need_herdr; ROWS=9; [ "${1:-}" = "--rows" ] && ROWS=${2:-9}
    out=$(herdr agent rename "$HERDR_PANE_ID" controller 2>&1) && echo "agent → controller" || case "$out" in   # (012) 009 bug 1: say so, and take controller-<ws> (names are global — L012; automations use the pane id)
      *agent_name_taken*) herdr agent rename "$HERDR_PANE_ID" "controller-$WS" >/dev/null 2>&1 && echo "agent → controller-$WS (global name 'controller' is held by another room — pane id still pins this controller)" || echo "agent rename failed: ${out:0:140}";;
      *) echo "agent rename failed: ${out:0:140}";; esac
    herdr tab rename "$HERDR_TAB_ID" "CONTROLLER" >/dev/null 2>&1 && echo "tab → CONTROLLER"
    mkdir -p "$ROOT/docs/briefs/results"
    [ -f "$ROOT/docs/briefs/STATUS.md" ] || cat > "$ROOT/docs/briefs/STATUS.md" <<EOF
# STATUS — control room board ($(basename "$ROOT"))
**Where to go:** Herdr workspace \`$WS\` → tab **CONTROLLER** (agent \`controller\`). Talk to it; it briefs, launches, integrates.

## Workers
| pane | agent | brief | state | result |
|---|---|---|---|---|

## Decisions waiting on the human
1.

## How to use the agents
\`herdr agent list\` · \`herdr agent read <name> --source recent-unwrapped --lines 60\` · \`herdr agent prompt <name> "…"\` · \`herdr agent focus <name>\`
Only **blocked** needs a human. New work → \`docs/briefs/<X>.md\` (objective · inputs · constraints · deliverable · where to write) → ask controller to launch.
Results land in \`docs/briefs/results/\`; chat is ephemeral, files are the memory.
EOF
    # status strip: split down, then shrink the new pane to ROWS (idempotent: skipped when this workspace already has a pane labelled "status" (005))
    have=$(herdr pane list 2>/dev/null | WS="$WS" python3 -c 'import json,sys,os
d=json.load(sys.stdin)["result"]; ps=d.get("panes",d); ws=os.environ.get("WS","")
print(next((p["pane_id"] for p in ps if (p.get("label") or "")=="status" and str(p.get("pane_id","")).startswith(ws+":")),""))' 2>/dev/null)
    if [ -n "$have" ]; then echo "strip  → $have (unchanged)"; "$0" strip-check --pane "$have" --quiet; else   # (015) a strip pane that came back as a bare shell after a Herdr restart gets its pager back
    pane=$(herdr pane split --current --direction down --ratio 0.5 --cwd "$ROOT" --no-focus 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')
    sleep 2; herdr pane rename "$pane" status >/dev/null 2>&1
    total=$(herdr pane layout --pane "$HERDR_PANE_ID" 2>/dev/null | python3 -c 'import json,sys; l=json.load(sys.stdin)["result"]["layout"]; print(l["area"]["height"])')
    frac=$(python3 -c "print(max(0.05, min(0.5, 1 - ($ROWS+1)/$total)))")
    herdr pane resize --pane "$pane" --direction down --amount "$frac" >/dev/null 2>&1
    herdr pane run "$pane" "controlroom statusbar" >/dev/null 2>&1 && echo "status strip → pane $pane ($ROWS rows)"
    fi
    mem_py init $MEMFLAGS   # memory (004): docs/briefs/memory/ + LESSONS seed, idempotent
    echo "$HERDR_PANE_ID" > "$ROOT/logs/.controller"   # (006) automations prompt this pane (L012: by id, not by the global name)
    tick_install            # tick (005): AUTOMATIONS.md + launchd unit, idempotent; first tick re-arms watch rows from STATUS.md
    cr5 auto round          # (012) 010 §4(c): the standing 2 h round wake, once; Boot re-arms it if it is ever missing
    echo "board  → $ROOT/docs/briefs/STATUS.md"; echo "done. next: controlroom launch <name> docs/briefs/<X>.md"
    ;;
  launch)
    need_herdr; FORCE=0; A1=""; A2=""; A3=""
    for a in "$@"; do if [ "$a" = --force ]; then FORCE=1; elif [ -z "$A1" ]; then A1=$a; elif [ -z "$A2" ]; then A2=$a; else A3=$a; fi; done   # (005) --force bypasses PAUSED
    NAME=$A1; BRIEF=$A2; LABEL=${A3:-"worker: $NAME"}
    [ -z "$NAME" ] || [ -z "$BRIEF" ] && { echo "usage: controlroom launch <name> docs/briefs/<NNN-slug>.md [tab label] [--force]"; exit 2; }
    [ -f "$PAUSED" ] && [ "$FORCE" = 0 ] && { echo "paused since $(sed -n 's/.*since=\([^ ]*\).*/\1/p' "$PAUSED") — controlroom play, or --force"; exit 3; }
    pane=$(herdr tab create --workspace "$WS" --cwd "$ROOT" --no-focus 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["root_pane"]["pane_id"])'); sleep 3
    herdr tab rename "${pane/:p/:t}" "$LABEL" >/dev/null 2>&1
    herdr agent start "$NAME" --kind pi --pane "$pane" --timeout 60000 >/dev/null 2>&1 || { echo "agent start failed in $pane"; exit 1; }
    sleep 2
    PRE="Read"; [ -f "$ROOT/docs/briefs/memory/LESSONS.md" ] && PRE="Read docs/briefs/memory/LESSONS.md first (project lessons; treat as rules). Then read"   # memory (004)
    herdr agent prompt "$NAME" "$PRE $BRIEF and execute it end to end. Work autonomously; do not ask questions unless truly blocked. Save deliverables where the brief specifies and write the final summary to docs/briefs/results/ as the brief says. Save partial results early and often. When done, reply with the single line: DONE $NAME" >/dev/null 2>&1
    row=$(cr5 auto arm "$NAME" "integrate $(basename "$BRIEF" .md) when DONE" "launch $(date '+%m-%d %H:%M')")   # (005) watch row; the tick verifies/toasts and survives restarts
    note "launched $NAME" "$BRIEF in $pane" none; echo "$NAME → $pane ($LABEL), ${row:-watch row NOT armed (ledger locked >10 s) — the tick re-arms it from STATUS.md once the board row says working}"   # (012)
    ;;
  watch)
    for a in "$@"; do (
      sleep 90   # grace period: ignore the pre-prompt idle right after launch
      while true; do
        tgt "$a"; st=$(herdr $M agent wait "$N" --until done --until blocked --until idle --timeout 3600000 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["result"]["agent"]["agent_status"])
except Exception: print("timeout")')
        case "$st" in
          done|idle)
            v=$(verify "$a")
            case "$v" in
              done)    note "worker $a: DONE" "results in docs/briefs/results/ — say ok in CONTROLLER" done; exit 0;;
              crashed) note "worker $a CRASHED (API/proxy error)" "fix cause, then: controlroom resume $a" request; exit 0;;
              *)       note "worker $a stopped WITHOUT DONE" "check pane; controlroom resume $a to continue" request; exit 0;;
            esac;;
          blocked)   note "worker $a NEEDS YOU" "herdr agent focus $a" request; exit 0;;
        esac
      done ) & done; wait ;;
  resume)   # controlroom resume <agent> [extra instruction] — re-prompt a stopped worker and re-arm the watcher
    need_herdr; NAME=${1:-}; EXTRA=${2:-}; [ -z "$NAME" ] && { echo "usage: controlroom resume <agent> [note]"; exit 2; }
    tgt "$NAME"; herdr $M agent prompt "$N" "Resume exactly where you stopped (your previous call failed or was cut off). Check your persisted files and logs first; do not redo finished steps. Every number in your results file must come from your own outputs; if a step did not complete, say so plainly instead of estimating. Finish the brief and reply with the single line: DONE $NAME. $EXTRA" >/dev/null 2>&1
    row=$(cr5 auto arm "$NAME" "" "resume $(date '+%m-%d %H:%M')")   # (005) re-arm the watch row instead of spawning a watcher
    note "resumed $NAME" "watch row re-armed" none; echo "$NAME resumed, ${row:-watch row armed}" ;;
  strip-restart)   # controlroom strip-restart [--pane <id>] — restart the status pager in THIS workspace's `status` pane (015: two rooms on one server share the label; never touch the other room's strip)
    need_herdr; pane=$(strip_pane "$@")
    [ -z "$pane" ] && { echo "no pane labelled status in workspace ${WS:-?} (pass --pane <id>)"; exit 1; }
    herdr pane send-keys "$pane" q >/dev/null 2>&1; sleep 0.5
    herdr pane run "$pane" "clear; cd '$ROOT' && HERDR_WORKSPACE_ID=${pane%%:*} HERDR_PANE_ID=$pane controlroom statusbar" >/dev/null 2>&1 && echo "status pager restarted in $pane" ;;
  strip-check)   # controlroom strip-check [--pane <id>] [--quiet] [--force] — is the pager alive in this workspace's `status` pane? If the pane shows a bare shell (Herdr restart), relaunch it. The tick calls this every pass.
    QUIET=0; FORCE=0; for a in "$@"; do case "$a" in --quiet) QUIET=1;; --force) FORCE=1;; esac; done
    [ "${HERDR_ENV:-}" = 1 ] || exit 0; pane=$(strip_pane "$@"); [ -z "$pane" ] && { [ "$QUIET" = 1 ] || echo "strip: no pane labelled status in workspace ${WS:-?}"; exit 0; }
    st=$(herdr pane read "$pane" --source visible --lines 60 --format text 2>/dev/null | python3 -c '
import sys,re
ls=[l.rstrip() for l in sys.stdin.read().splitlines() if l.strip()]
if any(re.search(r"refreshed \d\d:\d\d:\d\d",l) for l in ls[-3:]) or any("CONTROL ROOM" in l for l in ls[:3]): print("alive")
elif not ls or re.search(r"(\$|%|❯|>)\s*$",ls[-1]) or re.search(r"controlroom-pager: not found|Traceback|command not found","\n".join(ls[-6:])): print("dead")
else: print("busy")')
    case "$st" in
      alive) [ "$QUIET" = 1 ] || echo "strip $pane: pager alive";;
      busy) if [ "$FORCE" = 1 ]; then st=dead; else [ "$QUIET" = 1 ] || echo "strip $pane: something else is running there — not relaunching (--force to override)"; fi;;
    esac
    if [ "$st" = dead ]; then
      herdr pane run "$pane" "clear; cd '$ROOT' && HERDR_WORKSPACE_ID=${pane%%:*} HERDR_PANE_ID=$pane controlroom statusbar" >/dev/null 2>&1 && { echo "[$(date '+%m-%d %H:%M')] strip relaunched in $pane (pane showed no pager)" >> "$LOG"; echo "strip $pane: pager relaunched"; }
    fi ;;
  resume-stalled)  # controlroom resume-stalled [note] — resume every worker that stopped without DONE or crashed (e.g. after a network outage)
    need_herdr; NOTE=${1:-}; n=0
    for a in $(herdr agent list 2>/dev/null | WS="$WS" python3 -c 'import json,sys,os
ws=os.environ.get("WS")
for a in json.load(sys.stdin)["result"]["agents"]:
    if a.get("name") and not a["name"].endswith("controller") and (not ws or a.get("workspace_id")==ws) and a["agent_status"] in ("done","idle"): print(a["name"])'); do
      v=$(verify "$a"); case "$v" in crashed|stalled) "$0" resume "$a" "$NOTE" >/dev/null; echo "resumed $a ($v)"; n=$((n+1));; esac
    done; echo "$n resumed" ;;
  watch-log)
    f=${1:-}; label=${2:-${1:-}}; [ -n "$f" ] || { echo "usage: controlroom watch-log <file> <label>"; exit 2; }; until grep -qE 'END|DONE|rc=[0-9]' "$f" 2>/dev/null; do sleep 60; done
    note "pipeline: $label finished" "$(tail -1 "$f")" ;;
  retire)   # controlroom retire <agent> [reason]  — close the worker's tab; session file stays resumable
    NAME=${1:-}; REASON=${2:-retired}; [ -z "$NAME" ] && { echo "usage: controlroom retire <agent|pane> [reason]"; exit 2; }
    AGENTS_JSON=$(herdr agent list 2>/dev/null) NAME="$NAME" python3 - <<'PY' > /tmp/.cr_retire
import json,os
ags=json.loads(os.environ["AGENTS_JSON"])["result"]["agents"]; n=os.environ["NAME"]
a=next((x for x in ags if (x.get("name")==n or x["pane_id"]==n)),None)
print(f"{a['tab_id']} {a.get('agent_session',{}).get('value','')}" if a else "")
PY
    read -r TAB SESS < /tmp/.cr_retire; [ -z "$TAB" ] && { echo "no agent $NAME"; exit 1; }
    herdr tab close "$TAB" >/dev/null 2>&1 && echo "retired $NAME ($TAB) — resume: pi --resume $SESS"
    cr5 auto cancel "$NAME" >/dev/null 2>&1   # (005) watch row → cancelled
    note "retired $NAME" "$REASON · resume: $SESS" none
    [ -f "$ROOT/docs/briefs/STATUS.md" ] && ! grep -q '^## Retired' "$ROOT/docs/briefs/STATUS.md" && printf '\n## Retired workers (tab closed; session resumable)\n| agent | when | reason | resume |\n|---|---|---|---|\n' >> "$ROOT/docs/briefs/STATUS.md"
    [ -f "$ROOT/docs/briefs/STATUS.md" ] && printf '| %s | %s | %s | `pi --resume %s` |\n' "$NAME" "$(date '+%m-%d %H:%M')" "$REASON" "$SESS" >> "$ROOT/docs/briefs/STATUS.md" ;;
  gc)       # controlroom gc [--hours 24] [--apply] [--keep a,b]  — list (or retire) workers idle longer than N hours
    HOURS=24; APPLY=0; KEEP=""
    while [ $# -gt 0 ]; do case "$1" in --hours) HOURS=$2; shift 2;; --apply) APPLY=1; shift;; --keep) KEEP=$2; shift 2;; *) shift;; esac; done
    AGENTS_JSON=$(herdr agent list 2>/dev/null) WS="$WS" HOURS="$HOURS" KEEP="$KEEP" python3 - <<'PY' > /tmp/.cr_gc
import json,os,time
ags=json.loads(os.environ["AGENTS_JSON"])["result"]["agents"]; ws=os.environ.get("WS"); h=float(os.environ["HOURS"]); keep=set(filter(None,os.environ["KEEP"].split(",")))
for a in ags:
    if ws and a.get("workspace_id")!=ws: continue
    n=a.get("name") or a["pane_id"]
    if n=="controller" or n in keep or a["agent_status"] in ("working","blocked"): continue
    p=a.get("agent_session",{}).get("value"); 
    if not p or not os.path.exists(p): continue
    age=(time.time()-os.path.getmtime(p))/3600
    if age>=h: print(f"{n} {age:.1f}")
PY
    if [ ! -s /tmp/.cr_gc ]; then echo "gc: nothing idle > ${HOURS}h"; exit 0; fi
    while read -r n age; do
      if [ "$APPLY" = 1 ]; then "$0" retire "$n" "gc: idle ${age}h"; else echo "would retire $n (idle ${age}h)"; fi
    done < /tmp/.cr_gc
    [ "$APPLY" = 1 ] || echo "(dry run — add --apply)" ;;
  # ---- tick/health/pause (005) case arms ----
  tick)   # controlroom tick [--once] [--dry-run] [--loop] [--root R] — one reconciler pass (launchd runs it every 60 s); --loop = fallback runner under caffeinate -i
    LOOP=0; PASS=""
    while [ $# -gt 0 ]; do case "$1" in --root) cd "$2" 2>/dev/null && ROOT=$2 && LOG="$ROOT/logs/agents.log"; shift 2;; --loop) LOOP=1; shift;; *) PASS="$PASS $1"; shift;; esac; done
    [ -d "$ROOT/docs/briefs" ] || exit 0   # silent no-op outside a control room
    if [ "$LOOP" = 1 ]; then
      if command -v caffeinate >/dev/null 2>&1 && [ -z "${CR_CAFF:-}" ]; then CR_CAFF=1 exec caffeinate -i "$0" tick --root "$ROOT" --loop $PASS; fi
      mypg=$(ps -o pgid= -p $$ | tr -d ' '); others=$(pgrep -f "controlroom tick .*--loop|controlroom tick --loop" 2>/dev/null | while read -r pid; do [ "$pid" = "$$" ] || [ "$pid" = "$PPID" ] && continue; [ "$(ps -o pgid= -p $pid 2>/dev/null | tr -d ' ')" = "$mypg" ] && continue; d=$(readlink /proc/$pid/cwd 2>/dev/null || lsof -a -p $pid -d cwd -Fn 2>/dev/null | sed -n 's/^n//p'); [ "$d" = "$ROOT" ] && echo $pid; done | tr '\n' ' ')   # (014.4) one loop per room: refuse when another loop process for this ROOT is alive (the lock keeps extras safe, but one is enough)
      if [ -n "$others" ] && [ -z "${CR_LOOP_FORCE:-}" ]; then echo "tick: a loop is already running for $ROOT (pid $others) — not starting another (kill it, or CR_LOOP_FORCE=1)"; exit 0; fi
      echo "tick --loop: every 60 s — reconciles AUTOMATIONS.md (watch/wake/flush rows), health (stuck?/spinning?), strip; prints only actions; idle passes write logs/.tick.last silently"
      n=0; while true; do out=$("$0" tick --root "$ROOT" $PASS 2>&1); case "$out" in "tick: nothing to do") n=$((n+1)); [ $((n % 60)) -eq 0 ] && echo "[$(date '+%H:%M')] tick: quiet for $n passes";; *) printf '%s\n' "$out";; esac; sleep 60; done
    fi
    cr5 tick $PASS
    case " $PASS " in *" --dry-run "*) ;; *) rooms_py refresh --quiet; "$0" strip-check --quiet >/dev/null 2>&1;; esac ;;   # (015) remote machines → logs/.machines-cache.json (+ [label] events) · relaunch a dead strip pager
  health) cr5 health "$@" ;;
  automations) cr5 auto list "$@" ;;   # (006) --all shows cancelled rows
  pause) cr5 pause "$@" ;;
  play) cr5 play ;;
  tick-install) tick_install ;;
  tick-uninstall) tick_uninstall ;;
  lastline)   # controlroom lastline <agent> — last meaningful pane line (used by the strip detail and by health's stuck? check)
    [ -n "${1:-}" ] || { echo "usage: controlroom lastline <agent>"; exit 2; }; tgt "$1"; herdr $M agent read "$N" --source visible --lines 50 --format text 2>/dev/null | python3 -c '
import sys,re
lines=[l.rstrip() for l in sys.stdin.read().splitlines() if l.strip() and not set(l.strip())<=set("\u2500\u2550-\u2502\u250c\u2510\u2514\u2518 ")]
cmds=[l.strip() for l in lines if re.match(r"^\s*\$ ", l)]
if cmds: print("$ "+re.sub(r"^\$\s*","",cmds[-1])[:140]); sys.exit()
for l in reversed(lines):
    if re.search(r"claude|anthropic|\(auto\)|^~/|ctrl\+o|Working \u2500", l): continue
    print(l.strip()[:140]); break' ;;
  # ---- end 005 case arms ----
  # ---- automations (006) case arms ----
  wake) cr5 auto wake "$@" ;;             # controlroom wake <when> "<instruction>" [--prompt|--no-prompt] [--repeat spec] — prompts the controller when due (default yes)
  watch-path) cr5 auto watch-path "$@" ;;  # controlroom watch-path "<glob>" "<instruction>" [--prompt] — toast (default) when a newer file lands under the glob
  cancel) cr5 auto cancel "$@" ;;         # controlroom cancel A### (or <agent> for its watch row)
  # ---- end 006 case arms ----
  # ---- memory (004) case arms ----
  decide|lesson|supersede|memory|land) mem_py "$CMD" "$@" ;;   # see mem_py above · docs/design/durable-controlroom.md §1 §5
  # ---- end memory (004) case arms ----
  # ---- dream (007) case arms ----
  dream)   # controlroom dream [--reason r] [--since ISO|Nd] [--here] | --check — render prompts/dream.md → memory/.dream-brief.md, launch dreamer-N (or print it with --here)
    case " $* " in *" --check "*) dream_py check; exit $?;; esac
    REASON=manual; SINCE=""; HERE=0
    while [ $# -gt 0 ]; do case "$1" in --reason) REASON=$2; shift 2;; --since) SINCE=$2; shift 2;; --here) HERE=1; shift;; *) shift;; esac; done
    read -r BRIEF STAMP SINCE < <(dream_py render "$REASON" "$SINCE"); [ -z "${BRIEF:-}" ] && exit 1
    if [ "$HERE" = 1 ]; then cat "$ROOT/$BRIEF"; exit 0; fi
    N=1; while herdr agent list 2>/dev/null | grep -q "\"name\": *\"dreamer-$N\""; do N=$((N+1)); done   # names are global (L012); first free dreamer-N
    "$0" launch "dreamer-$N" "$BRIEF" "dreamer: $REASON" && cr5 auto arm "dreamer-$N" "dream --check, then promote/reject (report: memory/dreams/$STAMP.md)" "dream $(date '+%m-%d %H:%M')" >/dev/null && echo "dream $STAMP (since $SINCE) → dreamer-$N · when it says DONE: controlroom dream --check" ;;
  promote|reject) dream_py "$CMD" "$@" ;;
  # ---- end dream (007) case arms ----
  # ---- compaction (008) case arms ----
  event) cr5 event "$@" ;;   # controlroom event <kind> [arg] — called by extensions/controlroom.ts (flush-requested · compaction · ext-error) and by the tick fallback
  # ---- end compaction (008) case arms ----
  *) sed -n '2,/^set -u/{/^set -u/!p;}' "$0" ;;   # help = the header comment block, however long it grows
esac
