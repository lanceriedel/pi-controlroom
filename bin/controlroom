#!/bin/bash
# controlroom — turn the current Herdr pane's pi into a "controller" with a status strip and watchers.
# Works in any project. Requires HERDR_ENV=1 (run from inside a Herdr-managed pane).
#
#   controlroom init [--rows N]        rename agent→controller, tab→CONTROLLER, add status strip, scaffold docs/briefs
#   controlroom statusbar              (internal) the refreshing status strip
#   controlroom watch <agent>...       toast + logs/agents.log when agents finish/block
#   controlroom watch-log <file> <lbl> toast + log when a pipeline log shows END/DONE/rc=
#   controlroom launch <name> <brief> [tab-label]   new tab → pi → prompt with brief → watcher
#   controlroom status                 one-shot text status (what the strip shows)
#   controlroom retire <agent> [why]   close a worker's tab (session stays resumable), log it on the board
#   controlroom gc [--hours 24] [--apply] [--keep a,b]   list/retire workers idle longer than N hours
#   controlroom decide|lesson "<one-liner>" --from <source> [--slug s]   append a D###/L### line to docs/briefs/memory/ (no source, no line)
#   controlroom supersede <ID> <byID> · memory [--counts|--decisions|--lessons|--unsourced] · land [<agent|brief>…]  (memory + landed ledger)
#   controlroom tick [--once] [--dry-run] [--loop] [--root R]   the 60 s reconciler (launchd): watch rows → verify/toast, re-arm from STATUS.md, health, auto-play
#   controlroom health [--json] [<agent>…] · automations        last write / stuck? / spinning? / $ / ctx% per agent · the AUTOMATIONS.md table
#   controlroom pause [--resume-after Nm] [reason] · play       logs/PAUSED: launch refuses (exit 3, --force), workers drain · tick-install|tick-uninstall
#   controlroom wake <when> "<instr>" [--prompt|--no-prompt] [--repeat "every 30m"] · watch-path "<glob>" "<instr>" [--prompt] · cancel A### · automations [--all]   (006) rows the tick fires; wake prompts the controller
#   controlroom dream [--reason r] [--since ISO|7d] [--here] · dream --check · promote P###…|--all [--kind D|L] · reject P### [why]   propose-only memory consolidation (prompts/dream.md → dreamer-N)
#   controlroom event <kind> [arg] [src] (008) log an extension/tick event to logs/agents.log: flush-requested <pct> [ext|manual] (toast once, marker) · compaction <tokensBefore> (logs/.compactions) · ext-error <msg>
#   controlroom verify <agent> · lastline <agent> · resume <agent> [note] · resume-stalled [note] · strip-restart [--pane P] · strip-check [--force] · detail|detail-on|detail-off   (worker state from the pane · re-prompt + re-arm · pager (this workspace only) · relaunch a dead pager · strip detail)
#   <agent> may be `<machine>/<agent>` (a saved `herdr machine`) for verify · lastline · resume · watch — translated to `herdr --machine <machine>` (015)
#   controlroom cancel --prune-fired    (012) drop fired/cancelled one-shot rows from AUTOMATIONS.md (ids never reused) · touch logs/AUTOPROMPT-OFF = per-room kill switch (tick + strip)
set -u
CMD=${1:-help}; shift || true
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
LOG="$ROOT/logs/agents.log"; mkdir -p "$ROOT/logs" "$HOME/.config/controlroom"
[ -z "${HERDR_WORKSPACE_ID:-}" ] && [ -n "${HERDR_PANE_ID:-}" ] && export HERDR_WORKSPACE_ID="${HERDR_PANE_ID%%:*}"   # (014.2) derive ws from the pane id when Herdr didn't pass it — detail flag + WS must key the same everywhere
DETAIL_FLAG="$HOME/.config/controlroom/detail.${HERDR_WORKSPACE_ID:-default}"
WS=${HERDR_WORKSPACE_ID:-}
HUMAN=${CONTROLROOM_HUMAN:-YOU}   # name shown in "WAITING ON …"; set CONTROLROOM_HUMAN=Lance in your shell if you like

note(){ echo "[$(date '+%m-%d %H:%M')] $1 — $2" >> "$LOG"; herdr notification show "$1" --body "$2" --sound "${3:-done}" --position top-right >/dev/null 2>&1; }
# verify <agent> → working | blocked | done | crashed | stalled. herdr's "done/idle" only means the prompt stopped;
# stalled = the agent stopped with neither a DONE line nor an API error in its pane (needs a look or a resume).
# a worker is done when its pane shows the "DONE <name>" line; crashed when the tail shows a proxy/API error.
tgt(){ M=""; N=$1; case "$1" in */*) M="--machine ${1%%/*}"; N=${1#*/};; esac; }   # (015) `<machine>/<agent>` → herdr --machine <machine> … <agent>; sets M and N
verify(){
  tgt "$1"; set -- "$N"
  live=$(herdr $M agent list 2>/dev/null | NAME="$1" python3 -c 'import json,sys,os
try: print(next(a["agent_status"] for a in json.load(sys.stdin)["result"]["agents"] if a.get("name")==os.environ["NAME"]))
except Exception: print("")')
  case "$live" in working) echo working; return;; blocked) echo blocked; return;; esac
  herdr $M agent read "$1" --source visible --lines 200 --format text 2>/dev/null | NAME="$1" python3 -c '
import sys,re,os
t=sys.stdin.read(); name=os.environ["NAME"]; tail="\n".join(t.splitlines()[-40:])
if re.search(r"daily premium model limit|BadRequestError|RateLimitError|\"error\":\{|Error: [45]\d\d|overloaded_error|ECONNREFUSED", tail): print("crashed")
elif re.search(r"^\s*DONE\s+(%s|\d{3})\b" % re.escape(name), t, re.M): print("done")
else: print("stalled")'
}

need_herdr(){ [ "${HERDR_ENV:-}" = 1 ] || { echo "not inside a Herdr pane (HERDR_ENV!=1)"; exit 1; }; }
strip_pane(){   # (015) the `status` pane of THIS workspace ($HERDR_WORKSPACE_ID), or --pane <id>; empty when none. Two rooms on one server both label their strip `status`.
  while [ $# -gt 0 ]; do case "$1" in --pane) echo "$2"; return;; esac; shift; done
  herdr pane list 2>/dev/null | WS="$WS" python3 -c 'import json,sys,os
d=json.load(sys.stdin)["result"]; ps=d.get("panes",d); ws=os.environ.get("WS","")
c=[p["pane_id"] for p in ps if (p.get("label") or "")=="status" and (not ws or p.get("workspace_id")==ws or str(p.get("pane_id","")).startswith(ws+":"))]
print(c[0] if len(c)==1 or (c and ws) else "")'
}

status_text(){
  printf '\033[1m CONTROL ROOM  %s  %s\033[0m   (say "ok" in CONTROLLER to integrate · \033[31;1mblocked\033[0m = needs you)%s\n' "$(date '+%a %H:%M')" "$(basename "$ROOT")" "$(cr5 pause-hdr)"
  DETAIL=0; [ -f "$DETAIL_FLAG" ] && DETAIL=1
  AGENTS_JSON=$(herdr agent list 2>/dev/null); export AGENTS_JSON
  DETAIL="$DETAIL" rooms_py header   # (015) `ROOMS  local ▶ctl (PRIMARY) ⇄ <machine> ▶ctl · MODE · sync` — only when `herdr machine list` has rows
  DETAIL="$DETAIL" rooms_py agents   # (015) AGENTS grouped by host: local (<hostname>) then one group per saved machine (remote agents from logs/.machines-cache.json)
  DETAIL="$DETAIL" cr5 strip   # TICK heartbeat line (+ COST in detail) (005)
  printf ' PIPELINES  (last 10 by time · running=yellow · no-marker=no START/END lines in the log%s)\n' "$([ "$DETAIL" = 1 ] && echo ' · detail: show all')"
  ROOT="$ROOT" DETAIL="$DETAIL" python3 - <<'PY'
import os,re,time,glob
root=os.environ["ROOT"]; detail=os.environ.get("DETAIL")=="1"; now=time.time()
def age(t):
    d=now-t
    return f"{int(d//60)}m" if d<3600 else (f"{d/3600:.1f}h" if d<86400 else f"{d/86400:.1f}d")
rows=[]
for f in sorted(glob.glob(os.path.join(root,"logs","*.log"))):
    name=os.path.basename(f)[:-4]
    if name in ("agents","tick"): continue   # (012) 011 #11: tick.log is the tick's own log, not a pipeline
    try: lines=[l.rstrip() for l in open(f,errors="replace") if l.strip()]
    except Exception: continue
    mt=os.path.getmtime(f); last=lines[-1] if lines else ""
    marks=[l for l in lines if re.search(r"\bSTART\b|\bEND\b|\bDONE\b|rc=|FAIL|Traceback|PIPELINE",l)]
    lm=marks[-1] if marks else ""
    # a service log: a Traceback is stale if any successful request line (HTTP 200) follows it
    if "Traceback" in lm:
        idx=max(i for i,l in enumerate(lines) if l==lm)
        if any(re.search(r'" (200|204) -', l) for l in lines[idx+1:]): st_override="serving"; lm=lines[-1]
        else: st_override=None
    else: st_override=None
    if st_override: st,col=st_override,"\033[32m"
    elif re.search(r"rc=[1-9]|\bFAIL(ED)?\b|Traceback",lm): st,col="FAILED","\033[31;1m"
    elif re.search(r"\bEND\b|\bDONE\b|rc=0",lm): st,col="done","\033[32m"
    elif re.search(r"START",lm): st,col=("running","\033[33m") if now-mt<3*3600 else ("stale?","\033[90m")
    else: st,col="no-marker","\033[90m"
    rows.append((mt,st,col,name,age(mt),(lm or last)[:80]))
rows.sort(key=lambda r:-r[0])
if not detail: rows=rows[:10]
for mt,st,col,name,a,txt in rows:
    print(f"   {col}{st:<9}\033[0m {name:<20} {a:>5} ago  {txt}")
if not rows: print("   (none)")
PY
  printf ' EVENTS (logs/agents.log)\n'; [ -f "$LOG" ] && tail -5 "$LOG" | sed 's/^/   /' | cut -c1-140
  mem_py strip   # memory (004): one MEMORY line, omitted when docs/briefs/memory/ is absent
  cr5 auto strip   # automations (006): `AUTOMATIONS  N armed · next A### HH:MM (in Nm) · N held · fired today N`, omitted when only watch/play rows exist
  if [ -f "$ROOT/docs/briefs/STATUS.md" ]; then
    printf ' WAITING ON %s\n' "$(echo "$HUMAN" | tr a-z A-Z)"
    awk '/^## Decisions waiting/{f=1;next} /^## /{f=0} f && /^[0-9]+\./ && !/~~/' "$ROOT/docs/briefs/STATUS.md" | cut -c1-140 | sed 's/^/   /'
    local nb; nb=$(ls "$ROOT"/docs/briefs/*.md 2>/dev/null | grep -c -v -E 'README|STATUS|AUTOMATIONS')   # (014.1) newest first, last 6, "+N older"
    printf ' BRIEFS   %s%s\n' "$(ls -t "$ROOT"/docs/briefs/*.md 2>/dev/null | grep -v -E 'README|STATUS|AUTOMATIONS' | head -6 | xargs -n1 basename 2>/dev/null | sed 's/\.md$//' | tr '\n' ' ')" "$([ "$nb" -gt 6 ] && echo "· +$((nb-6)) older")"
  fi
}

# ---- tick/health/pause (005) ----  one reconciler (`tick`, launchd every 60 s) + `health` (stuck?/spinning?/$) + `pause`/`play`
# cr5 <tick|health|auto|pause|play|pause-hdr|strip|plist> [args…]; data via argv/env (stdin is the heredoc). Design: docs/design/durable-controlroom.md §2 §4 §6.
AUTOS="$ROOT/docs/briefs/AUTOMATIONS.md"; PAUSED="$ROOT/logs/PAUSED"
cr5(){ ROOT="$ROOT" SELF="$0" WS="$WS" LOG="$LOG" DETAIL="${DETAIL:-0}" python3 - "$@" <<'PY'
import json,os,re,sys,time,glob,subprocess,atexit,datetime as dt
ROOT=os.environ["ROOT"]; SELF=os.environ["SELF"]; WS=os.environ.get("WS") or None
BR=os.path.join(ROOT,"docs/briefs"); LOGS=os.path.join(ROOT,"logs"); AUTOS=os.path.join(BR,"AUTOMATIONS.md")
PAUSED=os.path.join(LOGS,"PAUSED"); HCACHE=os.path.join(LOGS,".health.json"); TICKLOG=os.path.join(LOGS,"tick.log"); HEART=os.path.join(LOGS,".tick.last"); LOCK=os.path.join(LOGS,".tick.lock")
TSTATE=os.path.join(LOGS,".tick-state.json"); CTRL=os.path.join(LOGS,".controller"); AUTOPROMPT=os.environ.get("CONTROLROOM_AUTOPROMPT","1")!="0" and not os.path.exists(os.path.join(LOGS,"AUTOPROMPT-OFF")); RAW=[]   # (006) · (012) 009 bug 5: `touch logs/AUTOPROMPT-OFF` is per-room and visible on the strip
STUCK=float(os.environ.get("CONTROLROOM_STUCK_MIN",20)); SPIN=float(os.environ.get("CONTROLROOM_SPIN_MIN",30)); IDLE=float(os.environ.get("CONTROLROOM_IDLE_MIN",10))
now=time.time(); NOW=dt.datetime.now(); cmd,args=sys.argv[1],sys.argv[2:]
KEYS=["id","kind","state","next","repeat","fired","prompt","instruction","source"]
COLS="| id | kind | state | next (local) | repeat | fired | prompt controller? | instruction | source |\n|---|---|---|---|---|---|---|---|---|\n"
HDR="# Automations — control room (%s)\nRows are read and rewritten by `controlroom tick` every minute. `armed` = will fire; `held` = paused; `fired` = done (once) · next (recurring); `cancelled` = via `controlroom cancel` (never delete or edit rows by hand — ids are never reused; `cancel --prune-fired` drops inert one-shots).\nKinds: `watch <agent>` (worker finished/blocked/stuck) · `play` (end a pause) · `wake` (time; prompts the controller by default) · `watch-path <glob>` (newest mtime changed; toast unless --prompt) · `dream` (wake with a fixed instruction) · `flush` / `post-compaction` (tick fallback when the controlroom extension is absent: ctx ≥ 75 %% / compaction seen). Controller pane id: logs/.controller.\n\n"%os.path.basename(ROOT)
RED,YEL,CYN,DIM,OFF="\033[31;1m","\033[33m","\033[36m","\033[90m","\033[0m"
def stamp(t=None): return (dt.datetime.fromtimestamp(t) if t else NOW).strftime("%m-%d %H:%M")
def agem(m): return "?" if m is None else (f"{int(m)}m" if m<60 else (f"{m/60:.1f}h" if m<1440 else f"{m/1440:.1f}d"))
def iso_epoch(ts):
    try: return dt.datetime.strptime(ts[:19],"%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc).timestamp()
    except Exception: return None
def parse_local(s):
    for f in ("%Y-%m-%dT%H:%M","%Y-%m-%d %H:%M"):
        try: return dt.datetime.strptime(s.strip(),f)
        except Exception: pass
def sh(cmd,timeout=10):
    try: return subprocess.run(cmd,capture_output=True,text=True,timeout=timeout).stdout
    except Exception: return ""
def lib(fn,*a):   # call an existing bash function (verify/note) from bin/controlroom — reuse, don't fork
    return subprocess.run(["bash","-c",f'cd "$ROOT" && source "{SELF}" __lib__ 2>/dev/null; {fn} "$@"',"_",*a],capture_output=True,text=True,timeout=20,env=dict(os.environ,ROOT=ROOT)).stdout.strip()
def agents():
    try: ags=json.loads(sh(["herdr","agent","list"]))["result"]["agents"]
    except Exception: return {}
    RAW[:]=ags; return {a["name"]:a for a in ags if a.get("name") and (not WS or a.get("workspace_id")==WS)}
def board():   # STATUS.md "## Workers" table → {agent: {brief,state}}
    out={}; sec=""
    try:
        for l in open(os.path.join(BR,"STATUS.md")):
            if l.startswith("## "): sec=l[3:].strip().lower()
            if sec.startswith("workers") and l.startswith("|"):
                c=[x.strip() for x in l.strip().strip("|").split("|")]
                if len(c)>=4 and c[1] not in ("agent","---","") and not c[1].startswith("-"): out[c[1]]={"brief":c[2],"state":c[3]}
    except Exception: pass
    return out
# --- AUTOMATIONS.md: the ledger is the state; whole table rewritten atomically. (012) 011 #1–#3: monotonic ids, one lock around every load→save, unparseable lines kept verbatim
POST=[]   # (012) lines inside/after the table that are not rows: kept verbatim below the table on save, never dropped
def load_autos():
    if not os.path.exists(AUTOS): return HDR,[]
    pre,rows,intab=[],[],False; POST[:]=[]
    for l in open(AUTOS):
        if l.startswith("| id |"): intab=True; continue
        if not intab: pre.append(l); continue
        if not l.strip() or set(l.strip())<=set("|-: "): continue   # blank / separator
        c=[x.strip().replace("\\|","|") for x in re.split(r"(?<!\\)\|",l.strip())][1:-1]   # `\|` inside a cell is a literal pipe (012)
        if len(c)>=9 and re.match(r"A\d+$",c[0]): rows.append(dict(zip(KEYS,c[:9])))
        else: POST.append(l if l.endswith("\n") else l+"\n")
    if pre and pre[0].startswith("# Automations — control room (") and len([l for l in pre if l.strip()])<=3: pre=HDR.splitlines(True)   # (012) 011 #22: our own preamble follows the current kinds
    return "".join(pre),rows
def save_autos(pre,rows):
    os.makedirs(BR,exist_ok=True); tmp=AUTOS+".tmp"
    open(tmp,"w").write(pre+COLS+"".join("| "+" | ".join(str(r[k]).replace("|","\\|") for k in KEYS)+" |\n" for r in rows)+("\n"+"".join(POST) if POST else "")); os.replace(tmp,AUTOS); save_state()   # ledger + next_id together
def lock(wait=True):   # (012) 011 #2/#12: mkdir lock (logs/.tick.lock) around every load→save; tick skips when busy, CLI arms wait ≤ 10 s; stale > 300 s reclaimed without racing
    for i in range(21):
        try: os.mkdir(LOCK); atexit.register(unlock); return True
        except FileExistsError:
            try: stale=now-os.path.getmtime(LOCK)>300
            except FileNotFoundError: continue
            if stale:
                try: os.rmdir(LOCK)
                except OSError: pass
                continue
            if not wait: return False
            time.sleep(0.5)
    die("AUTOMATIONS.md locked (logs/.tick.lock) for > 10 s — retry; if no tick is running: rmdir logs/.tick.lock")
def unlock():
    try: os.rmdir(LOCK)
    except OSError: pass
def next_id(rows):   # (012) 011 #1: monotonic, kept in .tick-state.json; seeded from every A### ever seen (ledger ∪ tick.log ∪ agents.log) so a hand-deleted row's id is never reused
    st=load_state(); n=st.get("next_id")
    if not n:
        ids=[int(x["id"][1:]) for x in rows]
        for f in (AUTOS,TICKLOG,os.path.join(LOGS,"agents.log")):
            try: ids+=[int(m) for m in re.findall(r"\bA(\d{3,})\b",open(f,errors="replace").read())]
            except Exception: pass
        n=max(ids+[0])+1
    st["next_id"]=n+1; return "A%03d"%n
def add_row(rows,kind,instr,source,prompt="no",nxt="—",repeat="—"):
    r=dict(id=next_id(rows),kind=kind,state="armed",next=nxt,repeat=repeat,fired="0",prompt=prompt,instruction=instr,source=source); rows.append(r); return r
def rows_for(rows,agent): return [r for r in rows if r["kind"]==f"watch {agent}"]
def row_age(r):   # seconds since the row's source stamp ("launch 10-27 12:05"); unknown → old
    m=re.search(r"(\d\d-\d\d \d\d:\d\d)$",r["source"])
    if not m: return 10**9
    t=dt.datetime.strptime(f"{NOW.year}-{m.group(1)}","%Y-%m-%d %H:%M")
    if t>NOW+dt.timedelta(days=1): t=t.replace(year=NOW.year-1)
    return (NOW-t).total_seconds()
def load_paused():
    if not os.path.exists(PAUSED): return None
    t=open(PAUSED).read(); d={k:(re.search(k+r"=(\S+)",t) or [None,"-"])[1] for k in ("since","until")}
    d["reason"]=(re.search(r'reason="([^"]*)"',t) or [None,""])[1]; return d
def load_cache():
    try: return json.load(open(HCACHE))
    except Exception: return {}
def save_cache(c):
    tmp=HCACHE+".tmp"; json.dump(c,open(tmp,"w")); os.replace(tmp,HCACHE)
# ---- automations (006) ----  wake / watch-path / cancel + prompting the controller (§2.3 §2.5); state outside the table lives in logs/.tick-state.json
TODAY=NOW.strftime("%Y-%m-%d"); UNIT={"s":1,"m":60,"h":3600,"d":86400}
RULES="Rules: files first (STATUS.md, results/, logs/agents.log). Do the round, update STATUS.md, record any decision/lesson with controlroom decide|lesson --from …, then end with one line: what you did and which automation wakes you next (controlroom automations)."
def die(m): print(m,file=sys.stderr); sys.exit(1)
_ST={}   # (012) one in-memory copy per process so add_row's next_id and the tick's bookkeeping save together
def load_state():
    if not _ST:
        try: _ST.update(json.load(open(TSTATE)))
        except Exception: pass
    return _ST
def save_state(s=None):
    if not _ST: return
    tmp=TSTATE+".tmp"; json.dump(_ST,open(tmp,"w")); os.replace(tmp,TSTATE)
def fmt(t): return t.strftime("%Y-%m-%d %H:%M")
def human(t): d=(t-NOW).total_seconds()/60; return (t.strftime("%H:%M") if t.date()==NOW.date() else t.strftime("%m-%d %H:%M"))+f" (in {agem(max(d,0))})"
def next_after(spec,base):   # next firing strictly after now for `every Nm|h|d|s` / `daily HH:MM` / `weekdays HH:MM`
    m=re.match(r"^every (\d+)([smhd])$",spec)
    if m:
        step=dt.timedelta(seconds=int(m.group(1))*UNIT[m.group(2)]); t=(base or NOW)+step
        while t<=NOW: t+=step
        return t
    m=re.match(r"^(daily|weekdays) (\d\d?):(\d\d)$",spec)
    if not m: die(f"bad repeat: {spec!r} (every 30m | daily 06:00 | weekdays 06:00)")
    t=NOW.replace(hour=int(m.group(2)),minute=int(m.group(3)),second=0,microsecond=0)
    while t<=NOW or (m.group(1)=="weekdays" and t.weekday()>4): t+=dt.timedelta(days=1)
    return t
def parse_when(s):   # → (first firing, repeat): 15m | 2h | 18:12 | 2026-10-28T06:00 | "every 30m" | "daily 06:00" | "weekdays 06:00"
    s=s.strip(); m=re.match(r"^(\d+)([smhd])$",s)
    if m: return NOW+dt.timedelta(seconds=int(m.group(1))*UNIT[m.group(2)]),"once"
    if re.match(r"^every |^daily |^weekdays ",s): return next_after(s,NOW),s
    m=re.match(r"^(\d\d?):(\d\d)$",s)
    if m: t=NOW.replace(hour=int(m.group(1)),minute=int(m.group(2)),second=0,microsecond=0); return (t if t>NOW else t+dt.timedelta(days=1)),"once"
    t=parse_local(s)
    if not t: die(f"bad <when>: {s!r} (15m | 2h | 18:12 | 2026-10-28T06:00 | \"every 30m\" | \"daily 06:00\" | \"weekdays 06:00\")")
    return t,"once"
def is_auto(r): return r["kind"].split()[0] in ("wake","dream","watch-path","flush","post-compaction")   # (008) flush rows are automations too
def next_wake(rows):   # (row, datetime) of the soonest armed wake/dream row, or None
    c=[(parse_local(r["next"]),r) for r in rows if r["kind"] in ("wake","dream") and r["state"]=="armed"]; c=[(t,r) for t,r in c if t]
    return (min(c,key=lambda x:x[0])[1],min(c,key=lambda x:x[0])[0]) if c else None
def is_ctl(n): return (not n) or n=="controller" or n.startswith("controller-") or n.endswith("controller")   # (012.1) init renames collisions to controller-<ws>; the strip and controller() must agree
def controller():   # L012: resolve by pane id recorded in logs/.controller (init / tick-install); fall back to the name `controller` in this workspace. (012) 011 #5: a recycled pane id whose agent is named something else is never the controller
    RAW or agents(); pid=open(CTRL).read().strip() if os.path.exists(CTRL) else ""
    a=next((x for x in RAW if pid and x["pane_id"]==pid and is_ctl(x.get("name"))),None) or next((x for x in RAW if x.get("name")=="controller" and (not WS or x.get("workspace_id")==WS)),None)
    return (a["pane_id"],a["agent_status"]) if a else (None,None)
def prompt_controller(rid,text,st,dry,cap=True):   # §2.5 → ok | off | backlog | blocked. working → still sent (pi queues typed input as a follow-up). (012) 011 #5: no controller = blocked (retry each tick, toast once after 30 min); 011 #6: cap=False for flush/post-compaction
    if not AUTOPROMPT: return "off"
    if "prompts" not in st:   # (012) 009 bug 6: state lost → rebuild this hour's count from agents.log
        try: st["prompts"]=[t.timestamp() for l in open(os.path.join(LOGS,"agents.log")) if "→ prompted controller" in l for t in [parse_local(f"{NOW.year}-{l[1:12]}")] if t and now-t.timestamp()<3600]
        except Exception: st["prompts"]=[]
    st["prompts"]=[t for t in st.get("prompts",[]) if now-t<3600]
    if cap and len(st["prompts"])>=6:
        if now-st.get("backlog_toast",0)>3600 and not dry: lib("note","automation backlog",f"{rid} waits — 6 controller prompts already this hour (cap)","none"); st["backlog_toast"]=now
        return "backlog"
    def stall(why,body):
        b=st.setdefault("blocked",{}); b.setdefault(rid,now)
        if now-b[rid]>1800 and not st.setdefault("blocked_toast",{}).get(rid) and not dry: lib("note",f"{why} 30 min — {rid} waiting",body,"request"); st["blocked_toast"][rid]=now
        return "blocked"
    tgt,status=controller()
    if not tgt: return stall("no controller found","logs/.controller is stale or the pane was renamed — re-run /controller (controlroom init) in the controller pane")
    if dry: return "ok"
    out=subprocess.run(["herdr","agent","prompt",tgt,text],capture_output=True,text=True,timeout=20) if status!="blocked" else None
    if out and out.returncode==0 and "agent_blocked" not in out.stdout+out.stderr:
        st["prompts"].append(now); st.get("blocked",{}).pop(rid,None); st.get("blocked_toast",{}).pop(rid,None); open(os.path.join(LOGS,"agents.log"),"a").write(f"[{stamp()}] {rid} fired → prompted controller ({tgt}, was {status})\n")
        p=ctl_jsonl(); m=re.search(r"\[(retry · )?"+re.escape(rid)+r"\b",text); st.setdefault("sent",{})[rid]={"ts":now,"off":os.path.getsize(p) if p and os.path.exists(p) else 0,"text":text,"tag":m.group(0) if m else text[:24]}; return "ok"   # (014) L039: remember what we sent so uptake() can see whether the turn ran; tag = `[A###` / `[retry · A###` (flush texts carry no id → their head)
    return stall("controller blocked","answer it (herdr agent focus controller) so automations can prompt it")
def ctl_jsonl():   # (014) the controller's session jsonl (herdr agent list → agent_session.value for the pinned pane), or None
    pid,_=controller(); a=next((x for x in RAW if x["pane_id"]==pid),None); return ((a or {}).get("agent_session") or {}).get("value")
def just_woke():   # (014) L039: the 08:00 wake lands seconds after the Mac wakes, before network/VPN is back → tick defers prompt rows one tick. macOS kern.waketime; else a > 5 min gap in .tick.last
    m=re.search(r"sec = (\d+)",sh(["sysctl","-n","kern.waketime"]))
    try: last=float(open(HEART).read().split()[0])
    except Exception: last=now
    return now-int(m.group(1))<120 if m else now-last>300
def uptake(st,dry,acts):   # (014) L039: for every prompt we sent, scan the controller jsonl past the send offset: user msg `[A###` → assistant entries. non-error/tool call → taken; all `stopReason: error` ≥ 3 min → aborted → re-prompt once; 2nd abort → toast once, retry every 15 min (D026: never spent); no user msg after 3 min (and not working) → paste lost → same
    sent=st.get("sent",{}); path=ctl_jsonl() if sent else None
    if not path: return
    for rid,s in list(sent.items()):
        seen=taken=False; errs=[]
        try: f=open(path,errors="replace"); f.seek(s.get("off",0))
        except OSError: continue
        for line in f:
            try: e=json.loads(line)
            except Exception: continue
            m=e.get("message",{}) if e.get("type")=="message" else {}; c=m.get("content")
            if m.get("role")=="user" and s.get("tag",f"[{rid}") in (c if isinstance(c,str) else "".join(x.get("text","") for x in c or [] if isinstance(x,dict))): seen=True; errs=[]
            elif m.get("role")=="assistant" and seen:
                if m.get("stopReason")!="error" or any(x.get("type")=="toolCall" for x in c or []): taken=True; break
                errs.append((iso_epoch(e.get("timestamp") or "") or now,m.get("errorMessage") or "error"))
        if taken: sent.pop(rid); acts.append(f"{rid} prompt taken (controller turn ran)"); continue
        if seen and errs and now-errs[-1][0]>=180: why=errs[-1][1]
        elif not seen and now-s["ts"]>=180 and controller()[1]!="working": why="prompt not taken"
        else: continue
        n=s.get("retried",0)
        if n>=1:   # (c) second abort: one toast, then keep trying every 15 min — the wake is never spent
            if not s.get("toasted") and not dry: lib("note",f"controller: wake {rid} failed twice ({why})","the tick re-prompts every 15 min — check network/VPN and the controller pane","request"); s["toasted"]=True
            if now-s.get("last",now-900)<900: continue
        if prompt_controller(rid,f"[retry · {rid} · earlier turn aborted: {why}] "+s["text"],st,dry,cap=False)!="ok": continue   # bypasses the 6/h cap, counts toward it (D023)
        sent.get(rid,s).update(text=s["text"],retried=n+1,toasted=s.get("toasted"),last=now); acts.append(f"{rid} turn aborted ({why}) → re-prompted"+(f" (retry {n+1})" if n else ""))
        if not dry: open(os.path.join(LOGS,"agents.log"),"a").write(f"[{stamp()}] {rid} turn aborted ({why}) → re-prompted\n")
# ---- end 006 helpers (tick steps 5–6 and the CLI arms are marked (006) below) ----
# ---- compaction (008) ----  §7.4 shell fallback for the controller when extensions/controlroom.ts is absent, + `controlroom event`. Shared guard: logs/.flush-requested
FLUSH_PCT=int(os.environ.get("CONTROLROOM_FLUSH_PCT",75)); FLUSHED=os.path.join(LOGS,".flush-requested"); ALIVE=os.path.join(LOGS,".ext-alive"); COMPS=os.path.join(LOGS,".compactions")
FLUSH_TEXT="[controlroom · flush] Context at %d%% (threshold %d%%). Before compaction: run `controlroom memory`, then record every decision/lesson from this session that is not yet there (controlroom decide|lesson --from <file>), update STATUS.md, note your next wake. Then reply `/compact`."
ROUND="round: integrate DONE workers, controlroom land, update STATUS.md; this wake repeats every 2h — cancel it only when arming a replacement"   # (012) the standing round wake (init / Boot)
POST_TEXT=f"[controlroom · post-compaction] Your context was just compacted. Re-run Boot (STATUS.md, controlroom memory, automations). Record anything the summary mentions that memory lacks. If `controlroom automations` shows no armed recurring round wake, arm it: controlroom wake 2h \"{ROUND}\" --repeat \"every 2h\" --prompt"
def event(kind,arg="",src="ext"):   # one line in agents.log; compaction → .compactions {count,last}; flush-requested → marker + ONE toast per crossing
    os.makedirs(LOGS,exist_ok=True)
    if kind=="compaction":
        try: c=json.load(open(COMPS))
        except Exception: c={}
        c={"count":c.get("count",0)+1,"last":fmt(NOW),"tokensBefore":arg}; json.dump(c,open(COMPS,"w")); arg=f"#{c['count']} tokensBefore={arg}"
    if kind=="flush-requested":
        fresh=not os.path.exists(FLUSHED); open(FLUSHED,"w").write(f"{NOW:%Y-%m-%dT%H:%M} {src} {arg}\n")
        if fresh: lib("note","flush requested",f"controller ctx {arg}% ({src}) — asked to flush decisions/lessons to memory, then /compact","none"); return
    open(os.path.join(LOGS,"agents.log"),"a").write(f"[{stamp()}] {kind} — {arg}\n")
def ext_alive(s,path):   # (012) 011 #15 + 010 §4: the heartbeat counts only if < 30 min old, written by THIS session's pi (3rd field = session file) and its pid is a live `pi` whose cwd is ROOT — a hidden subagent inheriting HERDR_PANE_ID fails
    try: ts,pid,*sess=open(ALIVE).read().split(); mt=os.path.getmtime(ALIVE)
    except Exception: return False
    if mt<(s.get("start") or 0) or now-mt>1800 or (sess and sess[0]!=path): return False
    return bool(re.search(r"(^|/)pi(\s|$)",sh(["ps","-o","command=","-p",pid]).strip())) and f"n{ROOT}\n" in sh(["lsof","-p",pid,"-a","-d","cwd","-Fn"])
def comp_step(rows,st,cache,dry,acts,changed):   # controller only: (1) ctx ≥ FLUSH_PCT ∧ no extension heartbeat ∧ no marker → arm a one-shot `flush` row; (2) compaction count rose → `post-compaction` row. Step 5 fires them this pass.
    pid,status=controller(); a=next((x for x in RAW if x["pane_id"]==pid),None); path=((a or {}).get("agent_session") or {}).get("value")
    if not path: return
    h=health(a.get("name") or "controller",status,path,"",cache,dry=dry); s=cache.get("sessions",{}).get(path) or {}
    alive=ext_alive(s,path); pct=h.get("ctx_pct"); fs=st.setdefault("flush",{}); fs["ext"]=alive
    if pct is not None and pct<FLUSH_PCT:
        if os.path.exists(FLUSHED) and not dry and " manual " not in open(FLUSHED).read()+" ": os.remove(FLUSHED)   # below the line again → the next crossing may fire (either path). (012) 009 bug 4: a manual /flush marker is the extension's to clear
    elif pct is not None and not alive and not os.path.exists(FLUSHED) and not any(r["kind"]=="flush" and r["state"] in ("armed","held") for r in rows):
        r=add_row(rows,"flush",FLUSH_TEXT%(pct,FLUSH_PCT),f"tick {stamp()}",prompt="yes",nxt=fmt(NOW),repeat="once"); changed.append(True); acts.append(f"{r['id']} armed flush (ctx {pct}% ≥ {FLUSH_PCT}%, extension absent)")
        if not dry: event("flush-requested",str(pct),"tick")
    n=s.get("compactions",0); key="jsonl"   # (012) one source: pi writes a `compaction` entry however it was triggered; switching sources with the heartbeat re-fired old compactions (found by the 012 dry-run)
    if fs.get(key) is None or n<fs[key]: fs[key]=n   # first sight (or counter reset): baseline, don't fire for history
    elif n>fs[key]:
        fs[key]=n; r=add_row(rows,"post-compaction",POST_TEXT,f"tick {stamp()}",prompt="yes",nxt=fmt(NOW),repeat="once"); changed.append(True); acts.append(f"{r['id']} armed post-compaction (compactions {fs[key]} via {key})")
_MS={}
def window(model):
    if not _MS:   # (008) real contextWindow per model id from pi's models-store (claude-fable-5-1 = 1M, not the 200k default)
        def walk(o):
            if isinstance(o,dict):
                if "id" in o and "contextWindow" in o: _MS.setdefault(o["id"],o["contextWindow"])
                for v in o.values(): walk(v)
            elif isinstance(o,list):
                for v in o: walk(v)
        try: walk(json.load(open(os.path.expanduser("~/.pi/agent/models-store.json"))))
        except Exception: pass
        _MS.setdefault("",200000)
    if model in _MS: return _MS[model]
    m=(model or "").lower()
    for k,v in (("gpt-4.1",1000000),("gemini",1000000),("gpt-5",400000),("gpt-4o",128000)):
        if k in m: return v
    return 200000
# ---- end 008 helpers (window() above is 005's, now models-store-aware; tick hook, `event`/`strip` arms and the case arm are marked (008) below) ----
def parse_session(path,cache):
    try: st=os.stat(path)
    except OSError: return None
    today=NOW.strftime("%Y-%m-%d"); c=cache.setdefault("sessions",{}).get(path)
    if c and c.get("size")==st.st_size and c.get("today")==today and c.get("win")==window(c.get("model")): c["mtime"]=st.st_mtime; return c   # (008) win: recompute when the model window changes
    cost=toks=n=comp=ctx=0; ctoday=0.0; last_msg=last_write=first_ts=last_act=last_err=None; model=""
    for line in open(path,errors="replace"):
        try: e=json.loads(line)
        except Exception: continue
        t=e.get("type"); ts=e.get("timestamp") or ""; first_ts=first_ts or ts or None
        if t!="usage" and ts: last_act=ts   # (012) 009 bug 2: pi 1.4.0 cache_warm `usage` entries land every ~4.5 min during a blocking tool call — they are not activity
        if t=="message":
            m=e.get("message",{}); last_msg=ts or last_msg
            if m.get("role")=="assistant":
                u=m.get("usage") or {}; cc=(u.get("cost") or {}).get("total") or 0; cost+=cc; toks+=u.get("totalTokens") or 0; n+=1; model=m.get("model") or model; last_err=m.get("errorMessage") or "error" if m.get("stopReason")=="error" else None   # (014) strip shows an aborted last turn
                ep=iso_epoch(ts); ctoday+=cc if ep and dt.datetime.fromtimestamp(ep).strftime("%Y-%m-%d")==today else 0
                ctx=(u.get("input") or 0)+(u.get("cacheRead") or 0)+(u.get("cacheWrite") or 0)
                if any(x.get("type")=="toolCall" and x.get("name") in ("write","edit","bash") for x in m.get("content",[])): last_write=ts
        elif t in ("usage","compaction","branch_summary"):
            u=e.get("usage") or {}; cost+=(u.get("cost") or {}).get("total") or 0; toks+=u.get("totalTokens") or 0; comp+=t=="compaction"
            if t=="compaction": ctx=0   # (008) context unknown until the next assistant message → ctx % drops, re-arming the flush guard
    c=dict(size=st.st_size,mtime=st.st_mtime,today=today,cost=round(cost,2),cost_today=round(ctoday,2),tokens=toks,turns=n,model=model,last_msg=last_msg,last_act=iso_epoch(last_act or ""),
           last_write_tool=last_write,compactions=comp,ctx_pct=round(100*ctx/window(model)),win=window(model),last_err=last_err)
    m=re.match(r"(\d{4}-\d\d-\d\d)T(\d\d)-(\d\d)-(\d\d)",os.path.basename(path)); c["start"]=(iso_epoch(f"{m.group(1)}T{m.group(2)}:{m.group(3)}:{m.group(4)}") if m else iso_epoch(first_ts or "")) or st.st_mtime
    cache["sessions"][path]=c; return c
def health(name,status,path,brief,cache,toast=True,dry=False):
    s=parse_session(path,cache) if path else None
    h=cache.setdefault("agents",{}).setdefault(name,{}); h.update(status=status,path=path,ts=now)
    if not s: h.update(flag="",last_write=None); return h
    lw=[s["start"] or 0]+([iso_epoch(s["last_write_tool"])] if s["last_write_tool"] else [])
    bm=re.search(r"\d{3}",brief or ""); keys={name}|({bm.group(0)} if bm else set())   # (012) 011 #10
    for pat in ("docs/briefs/results/*","logs/*.log"):
        lw+=[os.path.getmtime(f) for f in glob.glob(os.path.join(ROOT,pat)) if any(k in os.path.basename(f) for k in keys)]
    lwt=max(x for x in lw if x); lw_age=(now-lwt)/60; j_age=(now-(s.get("last_act") or s["mtime"]))/60; flag=""   # (012) quiet = since the last non-usage entry, not mtime (L025)
    if status=="working":
        if lw_age>STUCK and j_age>=IDLE:   # candidate: no writes, session file quiet → confirm with an unchanged pane tail (lastline, existing)
            ll=sh([SELF,"lastline",name],6).strip()
            if h.get("lastline") is not None and h.get("lastline")==ll: flag="stuck?"
            h["lastline"]=ll
        else:
            h["lastline"]=None
            if lw_age>SPIN and j_age<IDLE: flag="spinning?"
    else: h["lastline"]=None
    if flag=="stuck?" and toast and not dry and now-h.get("stuck_toast",0)>3600:
        lib("note",f"worker {name} STUCK?",f"working, but no write for {agem(lw_age)} and session quiet {agem(j_age)} — check pane / controlroom resume {name}","request"); h["stuck_toast"]=now
    h.update(flag=flag,last_write=agem(lw_age),last_write_min=round(lw_age,1),session_idle=agem(j_age),session_idle_min=round(j_age,1),cost=s["cost"],cost_today=s["cost_today"],tokens=s["tokens"],turns=s["turns"],ctx_pct=s["ctx_pct"],model=s["model"],compactions=s["compactions"],last_err=s.get("last_err"))
    return h
def fmt_health(n,h):
    c={"stuck?":RED,"spinning?":YEL}.get(h.get("flag"),"")
    if h.get("last_write") is None: return f"   {n:<18} {h.get('status','?'):<8} (no session file)"
    return (f"   {n:<18} {h['status']:<8} last write {h['last_write']:>5} · session quiet {h['session_idle']:>5} · ${h['cost']:.2f} · {h['tokens']/1e6:.1f}M tok · {h['turns']} turns · ctx {h['ctx_pct']}%"+(f"   {c}{h['flag']}{OFF}" if h.get("flag") else ""))
# --- the tick (§2.4 steps 1,2,3,4,8; 5–7 are brief 006/008)
def tick():
    dry="--dry-run" in args; verbose=dry or "--once" in args or sys.stdout.isatty()
    if not os.path.isdir(BR): return
    os.makedirs(LOGS,exist_ok=True)
    if not lock(wait=False): return   # (012) another tick (or a CLI arm) holds the ledger — skip this pass
    try: acts=tick_pass(dry)
    finally: unlock()
    if verbose: print("\n".join(("DRY  " if dry else "")+a for a in acts) if acts else "tick: nothing to do")
def tick_pass(dry):
    acts=[]; pre,rows=load_autos(); changed=[not os.path.exists(AUTOS)]; cache=load_cache(); st=load_state()
    if POST and st.get("skipped")!=len(POST): acts.append(f"tick: skipped {len(POST)} unparseable row(s) in AUTOMATIONS.md (kept verbatim below the table)"); st["skipped"]=len(POST)   # (012) 011 #3, logged once per count
    def note(t,b,s="done"):
        if not dry: lib("note",t,b,s)
    def fire(r,msg): r["state"]="fired"; r["fired"]=str(int(r["fired"] or 0)+1); changed.append(True); acts.append(f"{r['id']} {msg}")
    def advance(r):   # (006) after a wake/watch-path firing: fired+1; recurring → compute next, once → fired; counts toward `fired today`
        k=r["kind"].split()[0]; r["fired"]=str(int(r["fired"] or 0)+1); changed.append(True); st["fired"]={TODAY:st.get("fired",{}).get(TODAY,0)+1}
        if r["repeat"] in ("once","","—") and k!="watch-path": r["state"]="fired"
        else: r["state"]="armed"; r["next"]=fmt(next_after(r["repeat"],parse_local(r["next"]))) if k!="watch-path" else "—"
    def hold(r,why): r["state"]="held"; changed.append(True); acts.append(f"{r['id']} {r['kind'].split()[0]} due → held ({why})")
    def fire_auto(r,text):   # (006) one wake/watch-path firing: prompt the controller when the row says so, else toast; blocked/backlog → row stays due
        k=r["kind"].split()[0]; res="toast"
        if r["prompt"]=="yes" and woke and not capped:   # (014) just woke from sleep → the row stays due, fires next tick; dark-wake cycles starved A032 19 h → cap at 3 consecutive deferrals
            if "deferring prompts 1 tick (just woke)" not in acts: acts.append("deferring prompts 1 tick (just woke)"); st["deferred"]=dfr+1
            return
        if r["prompt"]=="yes" and capped and not any(a.startswith("just-woke deferral cap") for a in acts): acts.append(f"just-woke deferral cap ({dfr} consecutive) reached → firing prompts anyway"); st["deferred"]=0
        if r["prompt"]=="yes":
            res=prompt_controller(r["id"],text+("" if k in ("flush","post-compaction") else "\n"+RULES),st,dry,cap=k not in ("flush","post-compaction"))   # (008) flush texts are self-contained · (012) 011 #6: flush rows bypass the 6/h cap
            if res in ("blocked","backlog"):
                if st.setdefault("waiting",{}).get(r["id"])!=res: acts.append(f"{r['id']} {k} due → {res}, retrying each tick"); st["waiting"][r["id"]]=res
                return
        st.get("waiting",{}).pop(r["id"],None)
        if res!="ok": note(f"{r['id']} {k}",r["instruction"]+(" (autoprompt off)" if res=="off" else ""),"done")
        advance(r); acts.append(f"{r['id']} {k} fired → "+{"ok":"prompted controller","off":"toast (autoprompt off)","fail":"toast (no controller found)","toast":"toast"}[res]+(f" · next {r['next']}" if r["state"]=="armed" and k!="watch-path" else ""))
    paused=load_paused()
    if paused:   # step 2
        u=parse_local(paused["until"] or "")
        if u and u<=NOW:
            if not dry: os.remove(PAUSED)
            for r in rows:
                if r["kind"]=="play" and r["state"]=="armed": fire(r,"play (auto)")
            acts.append(f"play (auto) — pause since {paused['since']} ended · reason: {paused['reason'] or '—'}"); note("PLAY (auto)","pause ended — launches allowed again","done"); paused=None
    held=[r for r in rows if r["state"]=="held" and is_auto(r)]
    if held and paused is None:   # (006) §4 play: every held row fires now; the prompt?=yes ones collapse into ONE controller prompt
        yes=[r for r in held if r["prompt"]=="yes"]; res="toast"
        if yes: res=prompt_controller("play",f"[play] {len(yes)} automation(s) fired while paused: "+"; ".join(f"{r['id']} {r['instruction']}" for r in yes)+"\n"+RULES,st,dry)
        if yes and res in ("blocked","backlog"):   # (012) 011 #4: controller unreachable → prompt rows stay held and retry next tick (same bookkeeping as fire_auto); toast-only rows still fire
            if st.setdefault("waiting",{}).get("play")!=res: acts.append(f"play: {len(yes)} held prompt row(s) → {res}, retrying each tick"); st["waiting"]["play"]=res
            held=[r for r in held if r not in yes]; yes=[]
        else: st.get("waiting",{}).pop("play",None)
        for r in held:
            if r not in yes or res!="ok": note(f"{r['id']} {r['kind'].split()[0]} (fired on play)",r["instruction"],"done")
            advance(r)
        if held: acts.append(f"play: {len(held)} held row(s) fired — "+", ".join(r["id"] for r in held)+(f" · {len(yes)} collapsed into one controller prompt" if yes and res=="ok" else f" · toast ({res})"))
    ags=agents(); brd=board(); comp_step(rows,st,cache,dry,acts,changed)   # (008) step 7: may add flush / post-compaction rows that step 5 fires below
    woke=just_woke(); dfr=st.get("deferred",0); capped=woke and dfr>=3; woke and not capped or uptake(st,dry,acts)   # (014) step 5a: did the last prompts actually run? (skipped right after wake — the retry would hit the same dead window — unless the deferral cap is hit)
    if not woke: st["deferred"]=0
    for r in rows:   # step 3
        kind,_,arg=r["kind"].partition(" ")
        if r["state"] not in ("armed","held"): continue
        if kind=="watch":
            a=ags.get(arg)
            if a is None and "/" in arg:   # (015) remote target: look it up in logs/.machines-cache.json (refreshed by this tick)
                try: a=next((x for x in json.load(open(os.path.join(LOGS,".machines-cache.json")))["machines"].get(arg.split("/",1)[0],{}).get("agents",[]) if x.get("name")==arg.split("/",1)[1]),None)
                except Exception: a=None
            if a is None:
                if row_age(r)>180: fire(r,f"watch {arg}: agent not in herdr (retired / Herdr restarted) → toast"); note(f"worker {arg} GONE","not in herdr agent list — retired or Herdr restarted; resume from STATUS.md","request")
                continue
            v=a["agent_status"] if a["agent_status"] in ("working","blocked") else lib("verify",arg)
            if v=="working": st.get("toasted",{}).pop(r["id"],None)
            if v=="working" or (v=="stalled" and row_age(r)<180): continue   # 180 s launch grace = old watch loop's sleep 90
            t,b,s={"done":(f"worker {arg}: DONE","results in docs/briefs/results/ — say ok in CONTROLLER","done"),
                   "crashed":(f"worker {arg} CRASHED (API/proxy error)",f"fix cause, then: controlroom resume {arg}","request"),
                   "blocked":(f"worker {arg} NEEDS YOU",f"herdr agent focus {arg}","request")}.get(v,(f"worker {arg} stopped WITHOUT DONE",f"check pane; controlroom resume {arg} to continue","request"))
            if v in ("blocked","stalled"):   # (012) 011 #7: toast once per status and stay armed — only done/crashed/GONE consume the row, so the later DONE still fires
                if st.setdefault("toasted",{}).get(r["id"])!=v: note(t,b,s); st["toasted"][r["id"]]=v; acts.append(f"{r['id']} watch {arg} → {v} (toast, still armed)")
                continue
            note(t,b,s); fire(r,f"watch {arg} → {v} (toast)"+(" · watch-prompt deferred (v1), toast only" if r["prompt"]=="yes" else ""))
        elif kind=="play":
            nx=parse_local(r["next"])
            if paused is None and nx and nx<=NOW: fire(r,"play row past due with no PAUSED marker → fired")
        elif kind in ("wake","dream","flush","post-compaction"):   # (006) step 5 · (008) flush rows ride the same path (rate cap, blocked retry, hold while paused)
            nx=parse_local(r["next"])
            if r["state"]!="armed" or not nx or nx>NOW: continue
            if paused: hold(r,"paused"); continue
            fire_auto(r,r["instruction"] if kind in ("flush","post-compaction") else f"[{r['id']} · {kind} · fired {int(r['fired'] or 0)+1}/{r['repeat']} · {NOW:%H:%M}] {r['instruction']}")
        elif kind=="watch-path":   # (006) step 6: newest mtime under the glob > last_seen (state file) and ≥ 120 s old (debounce)
            fs=glob.glob(os.path.join(ROOT,arg),recursive=True); newest=max([os.path.getmtime(f) for f in fs],default=0); wp=st.setdefault("wp",{}); seen=wp.setdefault(r["id"],newest)
            if r["state"]!="armed" or newest<=seen or now-newest<120: continue
            wp[r["id"]]=newest
            if paused: hold(r,"paused"); continue
            fire_auto(r,f"[{r['id']} · watch-path · fired {int(r['fired'] or 0)+1}/on-change · {NOW:%H:%M}] {r['instruction']} — changed: {os.path.relpath(max(fs,key=os.path.getmtime),ROOT)}")
    for n,a in ags.items():   # health (§6): stuck?/spinning? only for working agents; cost refreshed for all (cached by size, so free)
        h=health(n,a["agent_status"],(a.get("agent_session") or {}).get("value"),brd.get(n,{}).get("brief",""),cache,dry=dry)
        if h.get("flag") and h.get("flag")!=cache.get("flag_logged",{}).get(n): acts.append(f"health {n}: {h['flag']} (last write {h['last_write']}, session quiet {h['session_idle']})")
        cache.setdefault("flag_logged",{})[n]=h.get("flag")
    for n,b in brd.items():   # step 4 re-arm: board says working/launched, agent live, no row ever → arm (fired rows block re-arm; `resume` re-arms explicitly)
        if b["state"].split()[0] in ("working","launched") and n in ags and not rows_for(rows,n):
            r=add_row(rows,f"watch {n}",f"integrate {b['brief']} when DONE",f"rearm {stamp()}"); changed.append(True); acts.append(f"{r['id']} armed watch {n} (rearm from STATUS.md)")
    if not dry:   # step 8
        if any(changed): save_autos(pre,rows)
        save_cache(cache); save_state(st); open(HEART,"w").write(f"{int(now)} {'ok' if not acts else str(len(acts))+' actions'}\n")
        if acts: open(TICKLOG,"a").write("".join(f"[{stamp()}] {a}\n" for a in acts))
    return acts
# --- subcommands
if cmd=="tick": tick()
elif cmd=="health":
    js="--json" in args; names=[a for i,a in enumerate(args) if not a.startswith("--") and (i==0 or args[i-1] not in ("--jsonl","--name","--status"))]
    opt=lambda k: args[args.index(k)+1] if k in args else None
    cache=load_cache(); brd=board(); out={}
    if opt("--jsonl"):   # point health at any session file (testing: fake a stuck worker with an old-mtime copy)
        n=opt("--name") or "test"; out[n]=health(n,opt("--status") or "working",opt("--jsonl"),brd.get(n,{}).get("brief",""),cache)
    else:
        ags=agents()
        for n in (names or sorted(ags)):
            a=ags.get(n)
            if not a: out[n]={"status":"missing","flag":"","last_write":None}; continue
            out[n]=health(n,a["agent_status"],(a.get("agent_session") or {}).get("value"),brd.get(n,{}).get("brief",""),cache)
    save_cache(cache)
    if js: print(json.dumps(out,indent=1))
    else:
        for n,h in out.items(): print(fmt_health(n,h))
        print(f"   {DIM}thresholds: stuck? = working ∧ last write > {agem(STUCK)} ∧ session quiet ≥ {agem(IDLE)} ∧ pane tail unchanged · spinning? = working ∧ last write > {agem(SPIN)} ∧ session growing{OFF}")
elif cmd=="auto":
    sub=args[0]; sub in ("arm","wake","watch-path","cancel","round") and lock(); pre,rows=load_autos()   # (012) 011 #2: writers take the tick lock
    if sub=="init":
        if os.path.exists(AUTOS): print("AUTOMATIONS.md present (skipped)")
        else: save_autos(pre,rows); print("AUTOMATIONS.md created")
    elif sub=="arm":   # auto arm <agent> <instruction|""> <source>
        n,instr,src=args[1],args[2],args[3]; have=rows_for(rows,n)
        if have: r=have[-1]; r.update(state="armed",next="—",source=src,instruction=instr or r["instruction"])
        else: r=add_row(rows,f"watch {n}",instr or f"integrate when DONE",src)
        save_autos(pre,rows); print(f"{r['id']} armed watch {n}")
    # ---- automations (006) arms: wake · watch-path · cancel A### · list --all · strip ----
    elif sub=="wake":   # auto wake <when> "<instruction>" [--prompt|--no-prompt] [--repeat spec]
        pos,rep,pr,i=[],None,"yes",1
        while i<len(args):
            if args[i]=="--repeat" and i+1<len(args): rep=args[i+1]; i+=2
            elif args[i] in ("--prompt","--no-prompt"): pr="yes" if args[i]=="--prompt" else "no"; i+=1
            else: pos.append(args[i]); i+=1
        if len(pos)<2: die('usage: controlroom wake <when> "<instruction>" [--prompt|--no-prompt] [--repeat "every 30m"|"daily 06:00"|"weekdays 06:00"]')
        nxt,rep0=parse_when(pos[0]); rep=rep or rep0
        if rep!="once": next_after(rep,NOW)   # validates the spec
        kind="dream" if pos[1].startswith("controlroom dream") else "wake"
        r=add_row(rows,kind,pos[1],f"wake {stamp()}",prompt=pr,nxt=fmt(nxt),repeat=rep); save_autos(pre,rows); at=human(nxt).split(" (")[0]+("" if rep=="once" else f" ({rep})")
        print(f"{r['id']} armed — {'wakes controller' if pr=='yes' else 'toast (no prompt)'} at {human(nxt)}{'' if rep=='once' else ' · '+rep}: \"{pos[1]}\"")
        print(f"→ Say to the human: \"{r['id']} wakes me at {at}; from that round I'll {pos[1]}.\"" if pr=="yes" else f"→ Say to the human: \"{r['id']} toasts you at {at}: {pos[1]}.\"")
    elif sub=="watch-path":   # auto watch-path "<glob>" "<instruction>" [--prompt]; baseline = current newest mtime so existing files never fire
        pos=[x for x in args[1:] if not x.startswith("--")]
        if len(pos)<2: die('usage: controlroom watch-path "<glob>" "<instruction>" [--prompt]')
        r=add_row(rows,f"watch-path {pos[0]}",pos[1],f"watch-path {stamp()}",prompt="yes" if "--prompt" in args else "no",repeat="on-change")
        s=load_state(); s.setdefault("wp",{})[r["id"]]=max([os.path.getmtime(f) for f in glob.glob(os.path.join(ROOT,pos[0]),recursive=True)],default=0); save_state(s); save_autos(pre,rows)
        print(f"{r['id']} armed — watch-path {pos[0]}: fires when a newer file appears (≥ 120 s old) → {'prompts controller' if r['prompt']=='yes' else 'toast'}: \"{pos[1]}\"")
    elif sub=="cancel" and len(args)>1 and args[1]=="--prune-fired":   # (012) the only row remover: fired/cancelled one-shot wake-type rows leave the table (watch rows stay — they block step-4 re-arm); ids are never reused, history stays in tick.log
        keep=[r for r in rows if r["state"] in ("armed","held") or r["kind"].startswith("watch") or r["repeat"] not in ("once","—","")]; n=len(rows)-len(keep); rows[:]=keep
        if n: save_autos(pre,rows)
        print(f"{n} fired/cancelled one-shot row(s) pruned from AUTOMATIONS.md (ids stay reserved: next {'A%03d'%load_state().get('next_id',0)}; history in logs/tick.log)")
    elif sub=="cancel" and len(args)>1 and re.match(r"A\d+$",args[1]):   # cancel A###
        r=next((x for x in rows if x["id"]==args[1]),None)
        if not r: die(f"{args[1]} not found")
        if r["state"] not in ("armed","held"): print(f"{r['id']} is {r['state']} — nothing to cancel"); sys.exit(0)
        r["state"]="cancelled"; r["source"]+=f" · cancelled {stamp()}"; save_autos(pre,rows); print(f"{r['id']} cancelled ({r['kind']})")
    elif sub=="round":   # (012) 010 §4(c): arm the standing round wake unless an armed recurring `round:` wake exists
        if any(r["kind"]=="wake" and r["state"]=="armed" and r["instruction"].startswith("round:") for r in rows): print("round wake present (skipped)")
        else: r=add_row(rows,"wake",ROUND,f"init {stamp()}",prompt="yes",nxt=fmt(NOW+dt.timedelta(hours=2)),repeat="every 2h"); save_autos(pre,rows); print(f"{r['id']} armed — round wake every 2h: prompts the controller to integrate/land/update STATUS")
    elif sub=="strip":   # AUTOMATIONS strip line (after MEMORY); silent when no wake/watch-path/dream rows exist
        A=[r for r in rows if is_auto(r) and r["state"]!="cancelled"]
        if not A: sys.exit()
        nx=next_wake(rows); held=sum(r["state"]=="held" for r in A)
        print(f" AUTOMATIONS  {sum(r['state']=='armed' for r in A)} armed"+(f" · next {nx[0]['id']} {human(nx[1])}" if nx else "")+(f" · {YEL}{held} held{OFF}" if held else "")+f" · fired today {load_state().get('fired',{}).get(TODAY,0)}"+("" if AUTOPROMPT else f"   {YEL}autoprompt off{OFF}"))
    # ---- end 006 arms ----
    elif sub=="cancel":
        len(args)>1 or die("usage: controlroom cancel A### | <agent>")   # (012) 011 #16
        k=[r for r in rows_for(rows,args[1]) if r["state"] in ("armed","held")]
        for r in k: r["state"]="cancelled"; r["source"]+=f" · cancelled {stamp()}"
        if k: save_autos(pre,rows)
        print(f"{len(k)} watch row(s) cancelled for {args[1]}")
    elif sub=="list":   # (006) hides cancelled rows unless --all; adds the `next:` line
        show=[r for r in rows if "--all" in args or r["state"]!="cancelled"]
        for r in show: print(f"   {r['id']} {r['kind']:<24} {r['state']:<9} next {r['next']:<17} fired {r['fired']:<3} prompt {r['prompt']:<3} {r['instruction'][:50]:<50} ← {r['source']}")
        if not show: print("   (no automations)"+(f" · {len(rows)-len(show)} cancelled (--all)" if len(rows)>len(show) else ""))
        nx=next_wake(rows); print((f"   next: {nx[0]['id']} {human(nx[1])}" if nx else "   next: — (no armed wake)")+("" if AUTOPROMPT else "   autoprompt off"))
elif cmd=="pause":
    mins=None; rest=[]; i=0
    while i<len(args):
        if args[i]=="--resume-after" and i+1<len(args):
            v=args[i+1]; mins=float(v[:-1])*(60 if v.endswith("h") else 1) if v[-1] in "mh" else float(v); i+=2
        else: rest.append(args[i]); i+=1
    reason=" ".join(rest); since=NOW.strftime("%Y-%m-%dT%H:%M"); until=(NOW+dt.timedelta(minutes=mins)).strftime("%Y-%m-%dT%H:%M") if mins else "-"
    os.makedirs(LOGS,exist_ok=True); open(PAUSED,"w").write(f'since={since} until={until} reason="{reason}"\n')
    msg=f"PAUSED since {since[11:]}"+(f" · play at {until[11:]}" if mins else "")
    if mins:
        lock(); pre,rows=load_autos()   # (012) 011 #2
        for r in rows:
            if r["kind"]=="play" and r["state"]=="armed": r["state"]="cancelled"
        r=add_row(rows,"play",f"play (from pause --resume-after {int(mins)}m)",f"pause {stamp()}",prompt="—",nxt=until.replace("T"," "),repeat="once"); save_autos(pre,rows); msg+=f" ({r['id']})"
    lib("note",msg,(reason or "no new launches; in-flight workers drain")+" — controlroom play to resume","none"); print(msg+" — launch refuses (use --force); workers drain; controlroom play to resume")
elif cmd=="play":
    p=load_paused()
    if not p: print("not paused"); sys.exit(0)
    os.remove(PAUSED); lock(); pre,rows=load_autos(); k=0   # (012) 011 #2
    for r in rows:
        if r["kind"]=="play" and r["state"]=="armed": r["state"]="cancelled"; r["source"]+=f" · play {stamp()}"; k+=1
    if k: save_autos(pre,rows)
    lib("note","PLAY",f"pause since {p['since'][11:]} ended — launches allowed again","done"); print(f"play — paused since {p['since']} ended"+(f"; {k} play row cancelled" if k else ""))
    unlock()
    if any(r["state"]=="held" for r in rows): tick()   # (006) fire held rows now, collapsed into one controller prompt
elif cmd=="pause-hdr":   # header fragment for status_text; empty when not paused
    p=load_paused()
    if p:
        n=sum(1 for a in agents().values() if a["agent_status"]=="working"); pre,rows=load_autos()
        pr=next((r for r in rows if r["kind"]=="play" and r["state"]=="armed"),None)
        print(f"   {YEL}PAUSED since {p['since'][5:].replace('T',' ')} · {n} draining"+(f" · play at {p['until'][11:]}"+(f" ({pr['id']})" if pr else "") if p["until"] not in ("-","") else "")+OFF)
    nx=next_wake(load_autos()[1])   # (006) header gains `next A002 18:12` when a wake is armed
    if nx: print(f"   {DIM}next {nx[0]['id']} {human(nx[1]).split(' (')[0]}{OFF}")
elif cmd=="strip":   # TICK line (+ COST line in detail) for status_text
    try: t,_,s=open(HEART).read().strip().partition(" "); t=float(t)
    except Exception: t=None
    if t is None: print(f" {RED}TICK  not running{OFF}  — controlroom tick-install (or: controlroom tick --loop)")
    elif now-t>300: print(f" {RED}TICK  not running{OFF}  last {time.strftime('%H:%M',time.localtime(t))} ({agem((now-t)/60)} ago) — controlroom tick-install")
    else: print(f" TICK  last {time.strftime('%H:%M:%S',time.localtime(t))} · {s}")
    if os.environ.get("DETAIL")=="1":
        A=load_cache().get("agents",{}); c=lambda f: sum(h.get("cost",0) for n,h in A.items() if f(n) and h.get("status")!="missing")
        print(f" COST  controller ${c(is_ctl):.2f} · workers ${c(lambda n: not is_ctl(n)):.2f} · today ${sum(h.get('cost_today',0) for h in A.values()):.2f}   {DIM}(from pi session jsonl; tick refreshes working agents){OFF}")
        cp=controller()[0]; cn_=next((x.get("name") for x in RAW if x["pane_id"]==cp),None); H=A.get(cn_) or next((h for n,h in A.items() if is_ctl(n) and h.get("status")!="missing"),{})   # the pinned pane's agent first
        fs=load_state().get("flush",{}); fs=load_state().get("flush",{})   # (008) controller context line
        try: fl=open(FLUSHED).read().split()[0][11:16]
        except Exception: fl="—"
        try: cn=json.load(open(COMPS)).get("count",0) if fs.get("ext") else H.get("compactions",0)
        except Exception: cn=H.get("compactions",0)
        print(f" CTX   controller ctx {H.get('ctx_pct','?')}% · compactions {cn} · flushed {fl} · extension {'alive' if fs.get('ext') else 'absent (tick fallback)'}"+(f"   {RED}⚠ last turn aborted ({H['last_err']}){OFF}" if H.get("last_err") else ""))   # (014)
elif cmd=="plist":   # launchd unit for the tick (§2.6); env verified by spike 005
    home=os.path.expanduser("~"); lab=args[0]
    print(f'''<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
